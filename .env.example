# ===========================================
# IKAS Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# --- Flask ---
FLASK_APP=app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-random-secret-key

# --- JWT ---
JWT_SECRET_KEY=change-this-to-a-different-random-secret-key
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ikas_dev_password
NEO4J_DATABASE=neo4j
NEO4J_MAX_POOL_SIZE=50

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ikas
PG_USER=ikas_user
PG_PASSWORD=ikas_dev_password
DATABASE_URL=postgresql://ikas_user:ikas_dev_password@localhost:5432/ikas

# --- LLM Provider ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=
# For Ollama: LLM_PROVIDER=ollama, LLM_BASE_URL=http://localhost:11434

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
