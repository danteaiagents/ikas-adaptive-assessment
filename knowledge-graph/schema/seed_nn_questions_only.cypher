// 1. Topic
MATCH (s:Subject {id: "s-ai"})
CREATE (s)-[:CONTAINS]->(t);

// 2. Concepts



// Prerequisite relationships between concepts

// 3. Resources

// 4. Generate 50 questions


// --- c-ai-nn-001 ---
CREATE (q:Question {id: "q-ai-nn-001", stem: "Which of the following are true about the perceptron model?", level: "Repeat", question_type: "mcq_multi", options: '["It can learn non-linear decision boundaries without hidden layers.", "It updates weights based on the error of its prediction.", "It uses a step function as its activation.", "It was originally designed as a hardware implementation.", "It uses backpropagation to update its weights."]', correct_answers: '["It updates weights based on the error of its prediction.", "It uses a step function as its activation.", "It was originally designed as a hardware implementation."]', explanation: "A standard perceptron updates weights based on errors, uses a step function, and was originally designed as hardware (Mark I Perceptron). It cannot learn non-linear boundaries on its own and uses the perceptron learning rule.", difficulty: -1.2, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-002", stem: "Which of these are characteristics of the Sigmoid activation function?", level: "Repeat", question_type: "mcq_multi", options: '["It outputs values strictly between -1 and 1.", "It outputs values strictly between 0 and 1.", "It suffers from the vanishing gradient problem for large input magnitudes.", "It is a linear function.", "Its derivative can be expressed in terms of the function itself."]', correct_answers: '["It outputs values strictly between 0 and 1.", "It suffers from the vanishing gradient problem for large input magnitudes.", "Its derivative can be expressed in terms of the function itself."]', explanation: "Sigmoid outputs (0, 1), suffers from vanishing gradients when inputs are large, and its derivative is f(x)(1-f(x)). It is non-linear and not (-1, 1).", difficulty: -1.0, discrimination: 1.2, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-003", stem: "What are the primary advantages of the ReLU (Rectified Linear Unit) activation function?", level: "Repeat", question_type: "mcq_multi", options: '["It completely eliminates the vanishing gradient problem for all inputs.", "It is computationally efficient compared to Sigmoid or Tanh.", "It induces sparsity in the hidden units.", "It is bounded between -1 and 1.", "It does not suffer from vanishing gradients for positive inputs."]', correct_answers: '["It is computationally efficient compared to Sigmoid or Tanh.", "It induces sparsity in the hidden units.", "It does not suffer from vanishing gradients for positive inputs."]', explanation: "ReLU is fast to compute, creates sparse representations by outputting 0 for negative inputs, and does not saturate for positive inputs. It can suffer from the dying ReLU problem for negative inputs.", difficulty: -0.8, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-004", stem: "How does the choice of activation function impact the training of deep neural networks?", level: "Summary", question_type: "mcq_multi", options: '["Non-linear activations allow the network to learn complex, non-linear mappings.", "Using linear activations in all layers makes the network equivalent to a single-layer linear regression model.", "The choice of activation function dictates the number of layers required.", "Activation functions determine the learning rate of the optimizer.", "Certain activation functions can cause gradients to vanish, severely impeding training in deep networks."]', correct_answers: '["Non-linear activations allow the network to learn complex, non-linear mappings.", "Using linear activations in all layers makes the network equivalent to a single-layer linear regression model.", "Certain activation functions can cause gradients to vanish, severely impeding training in deep networks."]', explanation: "Non-linear functions allow learning of non-linear mappings. Deep linear networks collapse to single linear layers. Activation functions like Sigmoid can cause vanishing gradients in deep networks.", difficulty: 0.2, discrimination: 1.3, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-005", stem: "Compare the Tanh and Sigmoid activation functions. Which statements are correct?", level: "Summary", question_type: "mcq_multi", options: '["Tanh outputs are zero-centered, while Sigmoid outputs are not.", "Sigmoid is bounded between -1 and 1, while Tanh is bounded between 0 and 1.", "Both Tanh and Sigmoid suffer from the vanishing gradient problem.", "Tanh gradients are generally steeper than Sigmoid gradients around zero.", "Sigmoid is generally preferred over Tanh in modern hidden layers."]', correct_answers: '["Tanh outputs are zero-centered, while Sigmoid outputs are not.", "Both Tanh and Sigmoid suffer from the vanishing gradient problem.", "Tanh gradients are generally steeper than Sigmoid gradients around zero."]', explanation: "Tanh is zero-centered (-1, 1) and has steeper gradients near zero, making optimization often easier. Both suffer from vanishing gradients. ReLU is generally preferred over both in hidden layers.", difficulty: 0.4, discrimination: 1.2, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-006", stem: "Why might a network with exclusively dying ReLUs fail to learn?", level: "Intuitive", question_type: "mcq_multi", options: '["Because the weights are constantly updated to larger and larger values.", "Because the gradients become exactly zero for those neurons.", "Because the neurons cease to update during backpropagation.", "Because the learning rate automatically drops to zero.", "Because the network effectively loses capacity as neurons become inactive."]', correct_answers: '["Because the gradients become exactly zero for those neurons.", "Because the neurons cease to update during backpropagation.", "Because the network effectively loses capacity as neurons become inactive."]', explanation: "Dying ReLUs occur when neurons constantly output zero, meaning their gradient is zero. They stop updating during backpropagation, effectively reducing the networks capacity.", difficulty: 1.2, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-007", stem: "Why is non-linearity crucial for the hidden layers of a neural network?", level: "Intuitive", question_type: "mcq_multi", options: '["It prevents the network from simply collapsing into a single linear transformation.", "It allows the network to partition the input space with complex, curved decision boundaries.", "It reduces the computational cost of the forward pass.", "It guarantees that the loss function will be strictly convex.", "It enables the network to approximate any continuous function, given sufficient width."]', correct_answers: '["It prevents the network from simply collapsing into a single linear transformation.", "It allows the network to partition the input space with complex, curved decision boundaries.", "It enables the network to approximate any continuous function, given sufficient width."]', explanation: "Non-linearity prevents layer collapse, allows complex decision boundaries, and is necessary for the Universal Approximation Theorem. It does not reduce computational cost or guarantee a convex loss function.", difficulty: 1.4, discrimination: 1.6, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-008", stem: "You are designing a binary classification output layer. Which combinations of activation and loss function are standard choices?", level: "Apply", question_type: "mcq_multi", options: '["Sigmoid activation with Binary Cross-Entropy loss.", "Softmax activation (with 2 output nodes) with Categorical Cross-Entropy loss.", "ReLU activation with Mean Squared Error loss.", "Tanh activation with Binary Cross-Entropy loss.", "Linear activation with Hinge loss."]', correct_answers: '["Sigmoid activation with Binary Cross-Entropy loss.", "Softmax activation (with 2 output nodes) with Categorical Cross-Entropy loss.", "Linear activation with Hinge loss."]', explanation: "Binary classification typically uses a single node with Sigmoid + Binary Cross-Entropy, two nodes with Softmax + Categorical Cross-Entropy, or a Linear node + Hinge loss (like an SVM).", difficulty: 2.0, discrimination: 1.7, guessing: 0.25, time_estimate_seconds: 60});

// --- c-ai-nn-002 ---
CREATE (q:Question {id: "q-ai-nn-009", stem: "Which of the following describes the Backpropagation algorithm?", level: "Repeat", question_type: "mcq_multi", options: '["It computes the gradient of the loss function with respect to the network weights.", "It applies the chain rule of calculus from the output layer back to the input layer.", "It is a biologically plausible mechanism for learning in the human brain.", "It updates the weights to maximize the loss function.", "It relies on dynamic programming to efficiently compute gradients by reusing intermediate derivatives."]', correct_answers: '["It computes the gradient of the loss function with respect to the network weights.", "It applies the chain rule of calculus from the output layer back to the input layer.", "It relies on dynamic programming to efficiently compute gradients by reusing intermediate derivatives."]', explanation: "Backpropagation efficiently computes gradients by applying the chain rule backwards, reusing intermediate terms (a form of dynamic programming). It is generally not considered biologically plausible and minimizes loss.", difficulty: -1.1, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-010", stem: "What are characteristics of Stochastic Gradient Descent (SGD)?", level: "Repeat", question_type: "mcq_multi", options: '["It computes the gradient using the entire training dataset at once.", "It updates weights using a single training example or a small mini-batch at each step.", "It generally exhibits more variance in its parameter updates compared to Batch Gradient Descent.", "It guarantees convergence to the global minimum for non-convex functions.", "It can escape shallow local minima more easily than Batch Gradient Descent due to update noise."]', correct_answers: '["It updates weights using a single training example or a small mini-batch at each step.", "It generally exhibits more variance in its parameter updates compared to Batch Gradient Descent.", "It can escape shallow local minima more easily than Batch Gradient Descent due to update noise."]', explanation: "SGD uses mini-batches, introducing noise (variance) that can help escape shallow local minima. It does not guarantee global convergence for non-convex functions like deep neural networks.", difficulty: -1.0, discrimination: 1.2, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-011", stem: "Which of the following are popular adaptive learning rate optimization algorithms?", level: "Repeat", question_type: "mcq_multi", options: '["Adam", "RMSprop", "Principal Component Analysis (PCA)", "Adagrad", "K-Means"]', correct_answers: '["Adam", "RMSprop", "Adagrad"]', explanation: "Adam, RMSprop, and Adagrad are adaptive optimizers. PCA and K-Means are unsupervised learning techniques.", difficulty: -1.3, discrimination: 0.9, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-012", stem: "How do optimizers like Adam and RMSprop differ from standard SGD?", level: "Summary", question_type: "mcq_multi", options: '["They maintain per-parameter learning rates instead of a single global learning rate.", "They require significantly less memory to run.", "They use moving averages of past gradients or squared gradients to adjust updates.", "They completely eliminate the need to tune the initial learning rate hyperparameter.", "They generally converge faster on complex, non-convex loss surfaces."]', correct_answers: '["They maintain per-parameter learning rates instead of a single global learning rate.", "They use moving averages of past gradients or squared gradients to adjust updates.", "They generally converge faster on complex, non-convex loss surfaces."]', explanation: "Adaptive optimizers adjust learning rates per parameter using moving averages of past gradients, often leading to faster convergence. They do not eliminate hyperparameter tuning and actually require MORE memory to store historical states.", difficulty: 0.3, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-013", stem: "What is the primary role of the learning rate in Gradient Descent?", level: "Summary", question_type: "mcq_multi", options: '["It determines the size of the step taken in the direction of the negative gradient.", "It controls the number of epochs required for training.", "A learning rate that is too high can cause the training loss to diverge.", "A learning rate that is too low can result in the model converging too slowly or getting stuck.", "It defines the architecture and depth of the neural network."]', correct_answers: '["It determines the size of the step taken in the direction of the negative gradient.", "A learning rate that is too high can cause the training loss to diverge.", "A learning rate that is too low can result in the model converging too slowly or getting stuck."]', explanation: "The learning rate scales the gradient step. If too high, the model diverges; if too low, it converges slowly. It does not define the architecture.", difficulty: 0.1, discrimination: 1.3, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-014", stem: "In the context of backpropagation, why does the vanishing gradient problem disproportionately affect earlier layers of deep networks?", level: "Intuitive", question_type: "mcq_multi", options: '["Because the chain rule involves multiplying many derivatives less than 1 together.", "Because earlier layers have more parameters than later layers.", "Because the loss is calculated at the output, and the signal degrades as it propagates backwards.", "Because activation functions like Sigmoid compress large inputs into a small range with small derivatives.", "Because optimizers deliberately reduce the learning rate for earlier layers."]', correct_answers: '["Because the chain rule involves multiplying many derivatives less than 1 together.", "Because the loss is calculated at the output, and the signal degrades as it propagates backwards.", "Because activation functions like Sigmoid compress large inputs into a small range with small derivatives."]', explanation: "Gradients vanish because multiplying many small derivatives (e.g., from Sigmoid) via the chain rule causes the gradient signal from the output to decay exponentially as it reaches earlier layers.", difficulty: 1.1, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-015", stem: "You are training a deep network and observe that the training loss fluctuates wildly and occasionally spikes upward. What are appropriate steps to take?", level: "Apply", question_type: "mcq_multi", options: '["Decrease the learning rate.", "Increase the learning rate.", "Increase the batch size.", "Add gradient clipping.", "Change the loss function to Mean Absolute Error."]', correct_answers: '["Decrease the learning rate.", "Increase the batch size.", "Add gradient clipping."]', explanation: "Wild fluctuations often mean the steps are too large or noisy. Decreasing learning rate, increasing batch size (to reduce variance), or adding gradient clipping can stabilize training.", difficulty: 1.8, discrimination: 1.6, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-016", stem: "If you are using momentum in your optimizer, how does it physically behave on the loss surface?", level: "Apply", question_type: "mcq_multi", options: '["It accelerates movement in directions with consistent gradients.", "It dampens oscillations in directions where gradients rapidly change sign.", "It allows the optimizer to smoothly roll over small local maxima or saddle points.", "It randomly jumps to different parts of the loss surface.", "It exactly computes the second derivative (Hessian) of the loss function."]', correct_answers: '["It accelerates movement in directions with consistent gradients.", "It dampens oscillations in directions where gradients rapidly change sign.", "It allows the optimizer to smoothly roll over small local maxima or saddle points."]', explanation: "Momentum accumulates a velocity vector, accelerating consistent directions and dampening oscillations, acting like a ball rolling with physical momentum over small bumps. It does not compute second derivatives.", difficulty: 2.2, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 60});

// --- c-ai-nn-003 ---
CREATE (q:Question {id: "q-ai-nn-017", stem: "What are the core building blocks of a Convolutional Neural Network (CNN)?", level: "Repeat", question_type: "mcq_multi", options: '["Convolutional layers that apply learnable filters.", "Recurrent layers for sequential memory.", "Pooling layers for spatial downsampling.", "Fully connected layers for final classification.", "Attention heads for temporal alignment."]', correct_answers: '["Convolutional layers that apply learnable filters.", "Pooling layers for spatial downsampling.", "Fully connected layers for final classification."]', explanation: "CNNs primarily consist of Convolutional layers, Pooling layers, and Fully Connected layers. Recurrent and Attention layers are not core to standard CNN architectures.", difficulty: -1.4, discrimination: 0.9, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-018", stem: "Which statements describe the stride and padding parameters in a convolutional layer?", level: "Repeat", question_type: "mcq_multi", options: '["Stride determines how many pixels the filter moves across the input.", "Padding involves adding borders (usually zeros) to the input tensor.", "Increasing stride generally increases the spatial dimensions of the output.", "Valid padding means no padding is added, causing spatial dimensions to shrink.", "Padding is used to prevent the vanishing gradient problem."]', correct_answers: '["Stride determines how many pixels the filter moves across the input.", "Padding involves adding borders (usually zeros) to the input tensor.", "Valid padding means no padding is added, causing spatial dimensions to shrink."]', explanation: "Stride is the step size. Padding adds borders. Valid padding means no padding. Increasing stride decreases output dimensions.", difficulty: -1.0, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-019", stem: "What is the purpose of Max Pooling in a CNN?", level: "Repeat", question_type: "mcq_multi", options: '["To reduce the spatial dimensions (width and height) of the representation.", "To introduce shift/translation invariance to small spatial changes.", "To increase the number of channels/feature maps.", "To reduce the computational cost and number of parameters in subsequent layers.", "To compute the loss function."]', correct_answers: '["To reduce the spatial dimensions (width and height) of the representation.", "To introduce shift/translation invariance to small spatial changes.", "To reduce the computational cost and number of parameters in subsequent layers."]', explanation: "Max pooling downsamples spatial dimensions, provides translation invariance, and reduces parameters/computation. It does not increase channels or compute loss.", difficulty: -0.9, discrimination: 1.2, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-020", stem: "Why are CNNs more effective for image processing than standard Multi-Layer Perceptrons (MLPs)?", level: "Summary", question_type: "mcq_multi", options: '["CNNs leverage parameter sharing, vastly reducing the number of weights to learn.", "CNNs preserve the spatial hierarchy and local connectivity of pixels.", "CNNs are completely immune to adversarial attacks.", "CNNs require less training data because filters can detect features anywhere in the image (translation equivariance).", "CNNs inherently process images faster than MLPs due to parallel execution."]', correct_answers: '["CNNs leverage parameter sharing, vastly reducing the number of weights to learn.", "CNNs preserve the spatial hierarchy and local connectivity of pixels.", "CNNs require less training data because filters can detect features anywhere in the image (translation equivariance)."]', explanation: "CNNs use parameter sharing and local receptive fields to preserve spatial structure and achieve translation equivariance, making them highly efficient and effective. They are not immune to adversarial attacks.", difficulty: 0.1, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-021", stem: "What role do $1\times1$ convolutions play in modern CNN architectures (like Inception or ResNet)?", level: "Summary", question_type: "mcq_multi", options: '["They act as a channel-wise pooling or dimensionality reduction mechanism.", "They increase the spatial resolution of the image.", "They add non-linearity without significantly increasing the spatial receptive field.", "They are used to combine features across different channels at the same spatial location.", "They replace max-pooling for spatial downsampling."]', correct_answers: '["They act as a channel-wise pooling or dimensionality reduction mechanism.", "They add non-linearity without significantly increasing the spatial receptive field.", "They are used to combine features across different channels at the same spatial location."]', explanation: "$1\times1$ convolutions reduce channel dimensions, add non-linearity, and combine channel features. They do not increase spatial resolution or replace spatial max-pooling.", difficulty: 0.4, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-022", stem: "As you progress deeper into a CNN, what typically happens to the features learned by the filters?", level: "Intuitive", question_type: "mcq_multi", options: '["The receptive field of the filters relative to the original input image grows larger.", "The features transition from simple edges and textures to complex object parts.", "The spatial resolution of the feature maps increases.", "The filters become highly sensitive to the exact absolute position of the object.", "The feature maps become more semantic and abstract."]', correct_answers: '["The receptive field of the filters relative to the original input image grows larger.", "The features transition from simple edges and textures to complex object parts.", "The feature maps become more semantic and abstract."]', explanation: "Deeper layers have larger effective receptive fields, learning complex, semantic, and abstract features (like faces) compared to early layers (edges). Spatial resolution typically decreases.", difficulty: 1.0, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-023", stem: "You want to design a CNN that outputs a segmentation mask of the same spatial size as the input image. Which architectural components are necessary?", level: "Apply", question_type: "mcq_multi", options: '["Max pooling layers only.", "Transposed convolutions (or upsampling layers).", "A fully connected layer at the very end.", "Skip connections (like in a U-Net architecture).", "An encoder-decoder structure."]', correct_answers: '["Transposed convolutions (or upsampling layers).", "Skip connections (like in a U-Net architecture).", "An encoder-decoder structure."]', explanation: "Image segmentation requires reconstructing spatial resolution, typically using transposed convolutions within an encoder-decoder architecture, often aided by skip connections (U-Net). Fully connected layers destroy spatial info.", difficulty: 2.1, discrimination: 1.7, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-024", stem: "If your CNN is severely overfitting on a small image dataset, which techniques are most appropriate to apply?", level: "Apply", question_type: "mcq_multi", options: '["Data augmentation (rotations, flips, crops).", "Increasing the depth and width of the network.", "Adding Dropout layers.", "Using Batch Normalization.", "Applying L2 weight regularization (weight decay)."]', correct_answers: '["Data augmentation (rotations, flips, crops).", "Adding Dropout layers.", "Applying L2 weight regularization (weight decay)."]', explanation: "Data augmentation, Dropout, and L2 regularization are standard methods to combat overfitting. Increasing network size usually worsens overfitting. Batch Norm can regularize slightly but is primarily for training stability.", difficulty: 1.7, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 60});

// --- c-ai-nn-004 ---
CREATE (q:Question {id: "q-ai-nn-025", stem: "What are the defining characteristics of Recurrent Neural Networks (RNNs)?", level: "Repeat", question_type: "mcq_multi", options: '["They contain feedback loops allowing information to persist across time steps.", "They process inputs of variable length sequentially.", "They process the entire sequence in parallel at the same time.", "They maintain a hidden state that is updated at each time step.", "They use exclusively 3x3 convolutional filters."]', correct_answers: '["They contain feedback loops allowing information to persist across time steps.", "They process inputs of variable length sequentially.", "They maintain a hidden state that is updated at each time step."]', explanation: "RNNs process sequential inputs sequentially, updating a persistent hidden state via feedback loops. They do not process sequences in parallel.", difficulty: -1.2, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-026", stem: "What is Backpropagation Through Time (BPTT)?", level: "Repeat", question_type: "mcq_multi", options: '["An algorithm that unrolls the recurrent network over time to apply standard backpropagation.", "A method to train the network without computing gradients.", "A technique that suffers heavily from exploding and vanishing gradients in long sequences.", "A reinforcement learning algorithm for sequential decision making.", "The standard way to calculate gradients in an RNN."]', correct_answers: '["An algorithm that unrolls the recurrent network over time to apply standard backpropagation.", "A technique that suffers heavily from exploding and vanishing gradients in long sequences.", "The standard way to calculate gradients in an RNN."]', explanation: "BPTT unrolls the RNN across time steps to apply backprop. It famously struggles with vanishing/exploding gradients over long sequences.", difficulty: -1.0, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-027", stem: "What are the core internal gates of a standard Long Short-Term Memory (LSTM) cell?", level: "Repeat", question_type: "mcq_multi", options: '["Forget gate", "Input gate", "Attention gate", "Output gate", "Pooling gate"]', correct_answers: '["Forget gate", "Input gate", "Output gate"]', explanation: "An LSTM cell uses a Forget gate, an Input gate, and an Output gate to regulate information flow. Attention and pooling are not standard LSTM gates.", difficulty: -1.3, discrimination: 0.9, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-028", stem: "How does an LSTM address the vanishing gradient problem of vanilla RNNs?", level: "Summary", question_type: "mcq_multi", options: '["By using a separate cell state acting as a long-term memory conveyor belt.", "By relying on additive interactions (the cell state update) rather than just multiplicative ones.", "By entirely removing all activation functions from the network.", "By using gating mechanisms to regulate what information is preserved or discarded.", "By processing sequences backwards."]', correct_answers: '["By using a separate cell state acting as a long-term memory conveyor belt.", "By relying on additive interactions (the cell state update) rather than just multiplicative ones.", "By using gating mechanisms to regulate what information is preserved or discarded."]', explanation: "LSTMs mitigate vanishing gradients by introducing an additive cell state pathway regulated by gates, allowing gradients to flow backwards unimpeded over long distances.", difficulty: 0.4, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-029", stem: "Compare LSTMs and GRUs (Gated Recurrent Units).", level: "Summary", question_type: "mcq_multi", options: '["GRUs generally have fewer parameters than LSTMs.", "GRUs merge the forget and input gates into a single update gate.", "LSTMs always perform significantly better than GRUs on all tasks.", "LSTMs have a separate cell state and hidden state, while GRUs only have a hidden state.", "GRUs cannot process time-series data."]', correct_answers: '["GRUs generally have fewer parameters than LSTMs.", "GRUs merge the forget and input gates into a single update gate.", "LSTMs have a separate cell state and hidden state, while GRUs only have a hidden state."]', explanation: "GRUs are a simplified LSTM variant with fewer parameters, combining gates and merging the cell and hidden states. They perform similarly on many tasks.", difficulty: 0.2, discrimination: 1.3, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-030", stem: "Why might a Bi-directional RNN (BiRNN) perform better than a standard RNN on text tagging tasks?", level: "Intuitive", question_type: "mcq_multi", options: '["Because the interpretation of a word often depends on the words that come after it, not just before it.", "Because BiRNNs require less training data.", "Because the backward pass provides future context to the current state.", "Because BiRNNs process the text twice as fast.", "Because BiRNNs prevent overfitting implicitly."]', correct_answers: '["Because the interpretation of a word often depends on the words that come after it, not just before it.", "Because the backward pass provides future context to the current state."]', explanation: "BiRNNs process the sequence forwards and backwards, providing both past and future context at each time step, which is crucial for language tasks.", difficulty: 1.1, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-031", stem: "You are designing an anomaly detection system for server logs that arrive as a continuous stream. Why might an LSTM be a good choice?", level: "Apply", question_type: "mcq_multi", options: '["LSTMs can maintain context of normal server behavior over long periods.", "LSTMs can process variable-length sequences of log events.", "LSTMs are immune to exploding gradients during training.", "The internal state of the LSTM can capture temporal dependencies in the log stream.", "LSTMs process entire sequences instantaneously."]', correct_answers: '["LSTMs can maintain context of normal server behavior over long periods.", "LSTMs can process variable-length sequences of log events.", "The internal state of the LSTM can capture temporal dependencies in the log stream."]', explanation: "LSTMs are designed for sequential streams, capturing long-term temporal dependencies and variable lengths.", difficulty: 1.9, discrimination: 1.6, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-032", stem: "During LSTM training, you observe NaN (Not a Number) in your loss. What is the most likely cause and appropriate fix?", level: "Apply", question_type: "mcq_multi", options: '["Exploding gradients; apply gradient clipping.", "Vanishing gradients; change all activations to Sigmoid.", "Learning rate is too high; decrease the learning rate.", "The sequences are too short; pad the sequences.", "Numerical instability in the loss function or softmax; use numerically stable implementations."]', correct_answers: '["Exploding gradients; apply gradient clipping.", "Learning rate is too high; decrease the learning rate.", "Numerical instability in the loss function or softmax; use numerically stable implementations."]', explanation: "NaN loss usually results from exploding gradients or a too-high learning rate causing numerical overflow, often fixable by gradient clipping, lowering LR, or ensuring numerical stability.", difficulty: 2.2, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 60});

// --- c-ai-nn-005 ---
CREATE (q:Question {id: "q-ai-nn-033", stem: "What are the primary components of the standard Transformer architecture?", level: "Repeat", question_type: "mcq_multi", options: '["Multi-Head Self-Attention mechanisms.", "Positional Encodings.", "Recurrent hidden states.", "Feed-Forward Neural Networks (FFNNs).", "Max Pooling layers."]', correct_answers: '["Multi-Head Self-Attention mechanisms.", "Positional Encodings.", "Feed-Forward Neural Networks (FFNNs)."]', explanation: "The standard Transformer (Vaswani et al.) uses Multi-Head Attention, FFNNs, and Positional Encoding. It explicitly drops Recurrence and Pooling.", difficulty: -1.5, discrimination: 0.9, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-034", stem: "In the scaled dot-product attention mechanism, what are the primary matrices involved?", level: "Repeat", question_type: "mcq_multi", options: '["Query (Q)", "Key (K)", "Value (V)", "State (S)", "Memory (M)"]', correct_answers: '["Query (Q)", "Key (K)", "Value (V)"]', explanation: "Self-attention computes weights using Query, Key, and Value matrices derived from the input.", difficulty: -1.2, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-035", stem: "Why does the Transformer architecture require Positional Encoding?", level: "Repeat", question_type: "mcq_multi", options: '["Because the self-attention mechanism processes all tokens in parallel and is permutation invariant.", "Because the model needs to know the sequential order of words in a sentence.", "Because it replaces the need for an optimizer.", "Because recurrent layers are completely removed from the architecture.", "Because it compresses the vocabulary size."]', correct_answers: '["Because the self-attention mechanism processes all tokens in parallel and is permutation invariant.", "Because the model needs to know the sequential order of words in a sentence.", "Because recurrent layers are completely removed from the architecture."]', explanation: "Since Transformers lack recurrence and process sequences in parallel, they have no inherent concept of order. Positional encodings inject sequence order information.", difficulty: -1.0, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-036", stem: "How does Self-Attention improve upon RNNs for long sequences?", level: "Summary", question_type: "mcq_multi", options: '["It allows direct connections between any two tokens in the sequence, regardless of distance.", "It avoids the sequential bottleneck, allowing for highly parallelized computation.", "It uses significantly less memory during training.", "The path length for gradients to travel between any two tokens is O(1).", "It completely solves the hallucination problem in language models."]', correct_answers: '["It allows direct connections between any two tokens in the sequence, regardless of distance.", "It avoids the sequential bottleneck, allowing for highly parallelized computation.", "The path length for gradients to travel between any two tokens is O(1)."]', explanation: "Self-attention connects all tokens directly (O(1) path length), bypassing the sequential bottleneck of RNNs and preventing vanishing gradients over distance. It is actually highly memory intensive (O(N^2)).", difficulty: 0.3, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-037", stem: "What is the purpose of Multi-Head attention?", level: "Summary", question_type: "mcq_multi", options: '["It allows the model to jointly attend to information from different representation subspaces.", "It enables the model to focus on different aspects of the context (e.g., grammatical vs. semantic relationships) simultaneously.", "It splits the sequence length into smaller, manageable chunks.", "It provides multiple independent gradient paths to improve training stability.", "It reduces the dimensionality of the final output."]', correct_answers: '["It allows the model to jointly attend to information from different representation subspaces.", "It enables the model to focus on different aspects of the context (e.g., grammatical vs. semantic relationships) simultaneously.", "It provides multiple independent gradient paths to improve training stability."]', explanation: "Multi-head attention uses multiple sets of Q, K, V weights, allowing the model to attend to different types of relationships (subspaces) concurrently.", difficulty: 0.2, discrimination: 1.3, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-038", stem: "Why is the dot product of Q and K scaled by $1/\sqrt{d_k}$ in scaled dot-product attention?", level: "Intuitive", question_type: "mcq_multi", options: '["To prevent the dot products from growing too large in magnitude.", "Because large dot products push the softmax function into regions with extremely small gradients.", "To ensure the output probabilities always sum to 1.", "To normalize the input vectors to unit length.", "To counteract the vanishing gradient problem inside the softmax function."]', correct_answers: '["To prevent the dot products from growing too large in magnitude.", "Because large dot products push the softmax function into regions with extremely small gradients."]', explanation: "For large dimensions, dot products grow large, pushing the softmax into regions with vanishingly small gradients. Scaling brings the variance back to 1.", difficulty: 1.3, discrimination: 1.6, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-039", stem: "You are implementing a causal language model (like GPT). How must the self-attention mechanism be modified?", level: "Apply", question_type: "mcq_multi", options: '["A lower-triangular mask must be applied to the attention scores.", "The model must be prevented from looking ahead at future tokens during training.", "The Query matrices must be disabled.", "The Positional Encoding must be removed.", "Future token attention scores are set to negative infinity before the softmax step."]', correct_answers: '["A lower-triangular mask must be applied to the attention scores.", "The model must be prevented from looking ahead at future tokens during training.", "Future token attention scores are set to negative infinity before the softmax step."]', explanation: "Causal (autoregressive) models use a mask (setting upper triangle to negative infinity) to prevent tokens from attending to future tokens, preserving the autoregressive property.", difficulty: 2.0, discrimination: 1.7, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-040", stem: "The $O(N^2)$ memory complexity of self-attention limits your context window. Which architectural adaptations can mitigate this?", level: "Apply", question_type: "mcq_multi", options: '["Using Sparse Attention mechanisms.", "Using Linear Attention approximations (e.g., Performer).", "Replacing attention with LSTMs.", "Implementing Sliding Window attention (e.g., Longformer).", "Using larger batch sizes."]', correct_answers: '["Using Sparse Attention mechanisms.", "Using Linear Attention approximations (e.g., Performer).", "Implementing Sliding Window attention (e.g., Longformer)."]', explanation: "Sparse, Linear, and Sliding Window attention variants are explicitly designed to reduce the $O(N^2)$ complexity of standard attention.", difficulty: 2.2, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 60});

// --- c-ai-nn-006 ---
CREATE (q:Question {id: "q-ai-nn-041", stem: "What is Transfer Learning in deep learning?", level: "Repeat", question_type: "mcq_multi", options: '["Taking a model trained on a large dataset and applying it to a different but related task.", "Using knowledge gained from one problem to improve learning on another.", "Transferring weights from a CPU to a GPU.", "Reusing pre-trained weights as a starting point instead of random initialization.", "Translating code from PyTorch to TensorFlow."]', correct_answers: '["Taking a model trained on a large dataset and applying it to a different but related task.", "Using knowledge gained from one problem to improve learning on another.", "Reusing pre-trained weights as a starting point instead of random initialization."]', explanation: "Transfer learning leverages knowledge (weights) learned on a source task/dataset to bootstrap learning on a target task.", difficulty: -1.4, discrimination: 0.9, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-042", stem: "Which of the following are common paradigms of Transfer Learning?", level: "Repeat", question_type: "mcq_multi", options: '["Feature Extraction (freezing base layers and training a new classifier head).", "Fine-tuning (unfreezing some or all base layers and training end-to-end).", "Zero-shot transfer.", "Randomizing all weights before transferring.", "Overfitting the source task."]', correct_answers: '["Feature Extraction (freezing base layers and training a new classifier head).", "Fine-tuning (unfreezing some or all base layers and training end-to-end).", "Zero-shot transfer."]', explanation: "Feature extraction, Fine-tuning, and Zero-shot transfer are all valid paradigms. Randomizing weights defeats the purpose.", difficulty: -1.2, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-043", stem: "What does it mean to freeze layers during fine-tuning?", level: "Repeat", question_type: "mcq_multi", options: '["Setting the learning rate of those layers to zero.", "Preventing the weights of those layers from being updated during backpropagation.", "Saving the model weights to disk.", "Ensuring the gradients for those layers are not computed (e.g., requires_grad=False).", "Running the model in inference mode only."]', correct_answers: '["Setting the learning rate of those layers to zero.", "Preventing the weights of those layers from being updated during backpropagation.", "Ensuring the gradients for those layers are not computed (e.g., requires_grad=False)."]', explanation: "Freezing layers stops their weights from updating by disabling gradient computation for those parameters during training.", difficulty: -1.1, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-044", stem: "Why is Transfer Learning highly effective in computer vision (e.g., using ImageNet models)?", level: "Summary", question_type: "mcq_multi", options: '["Early layers in CNNs learn general, fundamental features like edges and color blobs.", "These low-level features are universally useful across many different image domains.", "It drastically reduces the amount of labeled data required for the target task.", "It allows the model to process images of any arbitrary size without resizing.", "It eliminates the need for any backpropagation."]', correct_answers: '["Early layers in CNNs learn general, fundamental features like edges and color blobs.", "These low-level features are universally useful across many different image domains.", "It drastically reduces the amount of labeled data required for the target task."]', explanation: "CNNs trained on ImageNet learn universal early features (edges, textures). Transferring these drastically reduces the data and compute needed for new tasks.", difficulty: 0.1, discrimination: 1.3, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-045", stem: "What is Parameter-Efficient Fine-Tuning (PEFT)?", level: "Summary", question_type: "mcq_multi", options: '["Techniques that fine-tune only a small number of (extra) model parameters while freezing most pre-trained weights.", "Methods that significantly reduce the memory and compute required for fine-tuning Large Language Models.", "Techniques like LoRA (Low-Rank Adaptation) and Prompt Tuning.", "A method that prunes the network down to 1% of its original size.", "A way to train a model from scratch efficiently."]', correct_answers: '["Techniques that fine-tune only a small number of (extra) model parameters while freezing most pre-trained weights.", "Methods that significantly reduce the memory and compute required for fine-tuning Large Language Models.", "Techniques like LoRA (Low-Rank Adaptation) and Prompt Tuning."]', explanation: "PEFT methods (like LoRA) freeze the base model and train a tiny subset of parameters, saving massive amounts of memory and compute.", difficulty: 0.3, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-046", stem: "How does LoRA (Low-Rank Adaptation) work?", level: "Summary", question_type: "mcq_multi", options: '["It injects trainable low-rank decomposition matrices into the layers of the pre-trained model.", "It freezes the original pre-trained weights.", "It computes weight updates $\\Delta W$ as the product of two smaller matrices.", "It trains the model using only low-resolution images.", "It replaces the attention mechanism with a recurrent loop."]', correct_answers: '["It injects trainable low-rank decomposition matrices into the layers of the pre-trained model.", "It freezes the original pre-trained weights.", "It computes weight updates $\\Delta W$ as the product of two smaller matrices."]', explanation: "LoRA approximates weight updates using low-rank matrix decomposition (A*B), keeping the original weights frozen, significantly reducing trainable parameters.", difficulty: 0.4, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-047", stem: "When fine-tuning a pre-trained model, why is it common practice to use a much smaller learning rate than during pre-training?", level: "Intuitive", question_type: "mcq_multi", options: '["To prevent the pre-trained weights from being destroyed or heavily distorted (catastrophic forgetting).", "Because the model is already close to a good minimum for the general feature space.", "To make the training process run faster.", "Because large learning rates will cause the frozen layers to unfreeze.", "To ensure the new classification head learns slower than the base network."]', correct_answers: '["To prevent the pre-trained weights from being destroyed or heavily distorted (catastrophic forgetting).", "Because the model is already close to a good minimum for the general feature space."]', explanation: "Pre-trained models are already in a good region of parameter space. Large learning rates would violently update the weights, destroying the useful pre-learned features (catastrophic forgetting).", difficulty: 1.2, discrimination: 1.6, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-048", stem: "If your target dataset is very small and very visually different from the source dataset (e.g., medical scans vs. ImageNet), what is the best strategy?", level: "Intuitive", question_type: "mcq_multi", options: '["Freeze the entire network and only train a linear classifier on top.", "Train the entire network from scratch, ignoring the pre-trained weights.", "Fine-tune only the deeper layers, leaving the early layers frozen.", "It is a difficult scenario; transfer learning might provide limited benefit, but freezing most layers and tuning the top is safest to prevent overfitting.", "Use a higher learning rate to force the network to adapt."]', correct_answers: '["It is a difficult scenario; transfer learning might provide limited benefit, but freezing most layers and tuning the top is safest to prevent overfitting."]', explanation: "Wait, the requirement says 2-3 correct answers. Let me adjust the options.", difficulty: -1, discrimination: -1, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-048", stem: "If your target dataset is very small but visually different from the source dataset (e.g., medical scans vs. ImageNet), what are valid strategies?", level: "Intuitive", question_type: "mcq_multi", options: '["Freeze the early layers and only train the later, task-specific layers and classifier.", "Utilize strong data augmentation to artificially expand the small target dataset.", "Use the pre-trained weights as an initialization rather than training from scratch.", "Unfreeze and train all layers with a very high learning rate.", "Discard the pre-trained model and use a massive architecture."]', correct_answers: '["Freeze the early layers and only train the later, task-specific layers and classifier.", "Utilize strong data augmentation to artificially expand the small target dataset.", "Use the pre-trained weights as an initialization rather than training from scratch."]', explanation: "With small/different data, you risk severe overfitting if you train everything. Freezing early layers, using the weights as init, and augmenting data are best practices.", difficulty: 1.4, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-049", stem: "You are fine-tuning a BERT model for sentiment analysis. You add a new uninitialized classification head. What is a standard training procedure?", level: "Apply", question_type: "mcq_multi", options: '["Initially freeze the BERT body and train only the classification head to convergence.", "Then, unfreeze the BERT body and fine-tune the entire network with a very small learning rate.", "Apply a layer-wise learning rate decay, where lower layers have smaller learning rates.", "Train the entire network from step one with a large learning rate.", "Only use unsupervised data for the fine-tuning phase."]', correct_answers: '["Initially freeze the BERT body and train only the classification head to convergence.", "Then, unfreeze the BERT body and fine-tune the entire network with a very small learning rate.", "Apply a layer-wise learning rate decay, where lower layers have smaller learning rates."]', explanation: "A standard robust approach is to warm up the new head first, then unfreeze the body with a small learning rate, often using layer-wise decay to preserve early language features.", difficulty: 2.0, discrimination: 1.7, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q:Question {id: "q-ai-nn-050", stem: "You deploy a LoRA fine-tuned LLM. How can you optimize inference latency?", level: "Apply", question_type: "mcq_multi", options: '["Merge the trained LoRA weights into the original base model weights.", "The merged weights result in a model identical in architecture to the base model, incurring zero additional inference latency.", "Run the base model and the LoRA adapters on separate GPUs sequentially.", "Quantize the merged model to INT8 or INT4.", "Keep the LoRA weights separate and compute them dynamically for every token."]', correct_answers: '["Merge the trained LoRA weights into the original base model weights.", "The merged weights result in a model identical in architecture to the base model, incurring zero additional inference latency.", "Quantize the merged model to INT8 or INT4."]', explanation: "LoRA weights ($\Delta W$) can be added directly to the base weights ($W_{base} + \Delta W$). This merged model has zero latency overhead. Quantizing further speeds it up.", difficulty: 2.4, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 60});

