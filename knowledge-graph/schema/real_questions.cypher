// 4. Generate 50 questions

// --- c-ai-llm-001: What is an LLM ---
// Repeat (q001-q003)
CREATE (q001:Question {id: "q-ai-llm-001", stem: "Which of the following statements accurately describe Large Language Models (LLMs)?", level: "Repeat", question_type: "mcq_multi", options: '["They are built on the Transformer architecture.", "They process text token by token.", "They can only be trained on supervised, labeled datasets.", "They are a type of artificial neural network.", "They are fundamentally rule-based expert systems."]', correct_answers: '["They are built on the Transformer architecture.", "They process text token by token.", "They are a type of artificial neural network."]', explanation: "LLMs are artificial neural networks primarily based on the Transformer architecture. They process input text token by token to predict subsequent tokens. They are generally pre-trained on vast amounts of unlabeled data using self-supervised learning, not just supervised datasets, and they are not rule-based systems.", difficulty: -1.5, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 45});
CREATE (q002:Question {id: "q-ai-llm-002", stem: "During the initial pre-training phase, what is the primary objective of a standard causal Large Language Model?", level: "Repeat", question_type: "mcq_multi", options: '["Predicting the next token in a sequence.", "Learning the statistical patterns of the training data.", "Following human instructions perfectly.", "Translating text from one language to another.", "Minimizing the cross-entropy loss over a vast corpus of text."]', correct_answers: '["Predicting the next token in a sequence.", "Learning the statistical patterns of the training data.", "Minimizing the cross-entropy loss over a vast corpus of text."]', explanation: "Standard causal LLMs are pre-trained with the objective of predicting the next token, which inherently involves minimizing cross-entropy loss and learning statistical patterns. Instruction following is typically achieved in a later fine-tuning phase.", difficulty: -1.2, discrimination: 0.9, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q003:Question {id: "q-ai-llm-003", stem: "Which of the following are core components of the Transformer architecture used in LLMs?", level: "Repeat", question_type: "mcq_multi", options: '["Self-attention mechanism", "Recurrent neural network layers", "Feed-forward neural networks", "Positional encoding", "Convolutional filters"]', correct_answers: '["Self-attention mechanism", "Feed-forward neural networks", "Positional encoding"]', explanation: "The Transformer architecture relies on self-attention mechanisms, feed-forward neural networks, and positional encoding to process sequences. It explicitly avoids recurrent layers (like LSTMs) and typically does not use convolutional filters for language tasks.", difficulty: -1.0, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 45});

// Summary (q004-q006)
CREATE (q004:Question {id: "q-ai-llm-004", stem: "How do Large Language Models fundamentally differ from traditional Natural Language Processing (NLP) systems?", level: "Summary", question_type: "mcq_multi", options: '["LLMs typically use a single model for many tasks, whereas traditional NLP used task-specific models.", "LLMs rely more heavily on hand-crafted grammatical rules.", "LLMs require significantly larger amounts of compute and data to train.", "LLMs are less capable of handling ambiguous language.", "LLMs leverage self-supervised learning on massive datasets rather than strictly relying on labeled datasets."]', correct_answers: '["LLMs typically use a single model for many tasks, whereas traditional NLP used task-specific models.", "LLMs require significantly larger amounts of compute and data to train.", "LLMs leverage self-supervised learning on massive datasets rather than strictly relying on labeled datasets."]', explanation: "Traditional NLP often relied on task-specific models (e.g., a specific model for sentiment analysis) and labeled data. LLMs are general-purpose, trained on massive unlabeled datasets using self-supervised learning, requiring massive compute. LLMs actually handle ambiguity better and do not rely on hand-crafted rules.", difficulty: 0.0, discrimination: 1.2, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q005:Question {id: "q-ai-llm-005", stem: "Which of the following are known limitations of current Large Language Models?", level: "Summary", question_type: "mcq_multi", options: '["They are prone to hallucinating facts.", "They cannot generate code in programming languages.", "They lack a true understanding of the physical world.", "They can struggle with complex, multi-step logical reasoning.", "They are unable to process multiple languages."]', correct_answers: '["They are prone to hallucinating facts.", "They lack a true understanding of the physical world.", "They can struggle with complex, multi-step logical reasoning."]', explanation: "LLMs are prone to hallucinations, lack embodied understanding of the physical world, and often struggle with rigorous multi-step logic. They are, however, highly capable of generating code and processing multiple languages.", difficulty: -0.2, discrimination: 1.3, guessing: 0.25, time_estimate_seconds: 50});
CREATE (q006:Question {id: "q-ai-llm-006", stem: "What are the typical phases in the lifecycle of creating a modern conversational LLM (like ChatGPT)?", level: "Summary", question_type: "mcq_multi", options: '["Self-supervised pre-training on a large corpus.", "Supervised Fine-Tuning (SFT) on high-quality instruction data.", "Reinforcement Learning from Human Feedback (RLHF) or similar alignment techniques.", "Hand-coding the vocabulary grammar rules.", "Deploying without any safety guardrails."]', correct_answers: '["Self-supervised pre-training on a large corpus.", "Supervised Fine-Tuning (SFT) on high-quality instruction data.", "Reinforcement Learning from Human Feedback (RLHF) or similar alignment techniques."]', explanation: "Modern conversational LLMs typically go through pre-training, supervised fine-tuning (SFT), and alignment (like RLHF or DPO). Hand-coding grammar is not used, and safety guardrails are a standard part of deployment.", difficulty: 0.2, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 55});

// Intuitive (q007-q008)
CREATE (q007:Question {id: "q-ai-llm-007", stem: "Why do LLMs sometimes hallucinate (generate plausible but false information)?", level: "Intuitive", question_type: "mcq_multi", options: '["Because they prioritize statistical likelihood over factual accuracy.", "Because their training data contains contradictions and false information.", "Because they lack a grounded internal knowledge base or database to cross-reference.", "Because they are explicitly programmed to lie when they do not know the answer.", "Because they randomly pick words to ensure output diversity."]', correct_answers: '["Because they prioritize statistical likelihood over factual accuracy.", "Because their training data contains contradictions and false information.", "Because they lack a grounded internal knowledge base or database to cross-reference."]', explanation: "Hallucinations occur because LLMs generate text based on statistical likelihoods learned from vast, often messy training data. They lack a verifiable internal database to check facts against, meaning a statistically probable sequence might be factually false.", difficulty: 1.2, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q008:Question {id: "q-ai-llm-008", stem: "What does the concept of 'scaling laws' imply in the context of Large Language Models?", level: "Intuitive", question_type: "mcq_multi", options: '["Model performance generally improves predictably as compute, dataset size, and parameter count increase.", "Smaller models will eventually outperform larger models if trained long enough.", "There is a mathematical relationship between the size of the model and its loss on a validation set.", "Beyond a certain size, adding more data decreases the model\\'s performance.", "Increasing scale often leads to the emergence of unexpected capabilities not present in smaller models."]', correct_answers: '["Model performance generally improves predictably as compute, dataset size, and parameter count increase.", "There is a mathematical relationship between the size of the model and its loss on a validation set.", "Increasing scale often leads to the emergence of unexpected capabilities not present in smaller models."]', explanation: "Scaling laws dictate that performance predictably scales with compute, data, and parameters. This scaling often unlocks emergent abilities. It does not imply that more data decreases performance or that smaller models fundamentally surpass optimally trained larger ones.", difficulty: 1.5, discrimination: 1.6, guessing: 0.25, time_estimate_seconds: 65});

// Apply (q009-q010)
CREATE (q009:Question {id: "q-ai-llm-009", stem: "You are building a system for a hospital to extract patient symptoms from doctors' unstructured notes. Why might you choose an LLM over a traditional regex or rule-based system?", level: "Apply", question_type: "mcq_multi", options: '["The LLM can handle typos, abbreviations, and varied phrasing common in medical notes.", "The LLM guarantees 100% accuracy in data extraction.", "The LLM can infer symptoms based on contextual clues rather than exact keyword matches.", "The LLM will be cheaper and faster to run on edge devices than a rule-based system.", "The LLM can generalize to new, unseen symptom descriptions without needing explicit rule updates."]', correct_answers: '["The LLM can handle typos, abbreviations, and varied phrasing common in medical notes.", "The LLM can infer symptoms based on contextual clues rather than exact keyword matches.", "The LLM can generalize to new, unseen symptom descriptions without needing explicit rule updates."]', explanation: "LLMs excel at handling the variability, ambiguity, and context of human language (like typos and inferred meanings). However, they do not guarantee 100% accuracy and are typically much more expensive and computationally heavy than rule-based systems.", difficulty: 2.0, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 70});
CREATE (q010:Question {id: "q-ai-llm-010", stem: "A financial institution wants to use an LLM to calculate the exact compound interest for complex mortgage portfolios. What are the primary risks or drawbacks of this approach?", level: "Apply", question_type: "mcq_multi", options: '["LLMs are generally poor at performing precise, complex mathematical calculations.", "The LLM may hallucinate a plausible-sounding but incorrect financial figure.", "LLMs cannot process numbers or financial symbols.", "Using an LLM for deterministic math is computationally inefficient and costly compared to standard calculators.", "The LLM will refuse to answer due to financial safety guardrails."]', correct_answers: '["LLMs are generally poor at performing precise, complex mathematical calculations.", "The LLM may hallucinate a plausible-sounding but incorrect financial figure.", "Using an LLM for deterministic math is computationally inefficient and costly compared to standard calculators."]', explanation: "LLMs are statistical sequence predictors, making them unreliable for precise, complex arithmetic where a deterministic algorithm is required. They can process numbers, but using them for math is highly inefficient and risky due to potential hallucinations.", difficulty: 2.2, discrimination: 1.9, guessing: 0.25, time_estimate_seconds: 70});

// --- c-ai-llm-002: Tokenization ---
// Repeat (q011-q012)
CREATE (q011:Question {id: "q-ai-llm-011", stem: "What is the process of tokenization in the context of Large Language Models?", level: "Repeat", question_type: "mcq_multi", options: '["Translating the text into another language.", "Converting continuous text into discrete chunks or pieces.", "Assigning a unique numerical ID to each discrete piece of text.", "Encrypting the text to protect user privacy.", "Breaking text down into a format the neural network can process."]', correct_answers: '["Converting continuous text into discrete chunks or pieces.", "Assigning a unique numerical ID to each discrete piece of text.", "Breaking text down into a format the neural network can process."]', explanation: "Tokenization is the process of breaking text down into discrete chunks (tokens) and mapping them to numerical IDs (integers) so that the neural network can process them. It is not translation or encryption.", difficulty: -1.4, discrimination: 0.9, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q012:Question {id: "q-ai-llm-012", stem: "Which of the following are common tokenization algorithms used by modern LLMs?", level: "Repeat", question_type: "mcq_multi", options: '["Byte-Pair Encoding (BPE)", "WordPiece", "SentencePiece", "Bubble Sort", "K-Means Clustering"]', correct_answers: '["Byte-Pair Encoding (BPE)", "WordPiece", "SentencePiece"]', explanation: "BPE, WordPiece, and SentencePiece are standard subword tokenization algorithms used in LLMs. Bubble Sort is a sorting algorithm, and K-Means is a clustering algorithm.", difficulty: -1.0, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 35});

// Summary (q013-q014)
CREATE (q013:Question {id: "q-ai-llm-013", stem: "How does tokenization impact an LLM's performance on non-English languages?", level: "Summary", question_type: "mcq_multi", options: '["Non-English languages often require more tokens to represent the same meaning compared to English.", "Non-English text processing can be more expensive because API pricing is usually per token.", "Tokenizers trained primarily on English data may split non-English words into inefficient, very small chunks.", "Tokenization makes it impossible for LLMs to process non-English text.", "Tokenization standardizes all languages to have the exact same token-to-word ratio."]', correct_answers: '["Non-English languages often require more tokens to represent the same meaning compared to English.", "Non-English text processing can be more expensive because API pricing is usually per token.", "Tokenizers trained primarily on English data may split non-English words into inefficient, very small chunks."]', explanation: "Because tokenizers are often optimized on English-heavy corpora, they split non-English words into many small subwords or even bytes. This increases the token count, which increases API costs and decreases effective context length. It does not make non-English processing impossible.", difficulty: 0.3, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q014:Question {id: "q-ai-llm-014", stem: "What are the practical implications of a token limit (context window) in an LLM?", level: "Summary", question_type: "mcq_multi", options: '["It restricts the maximum length of the prompt you can provide.", "It limits the maximum length of the response the model can generate.", "It represents the total sum of input tokens and output tokens for a single request.", "It dictates the maximum number of users that can access the model simultaneously.", "It limits the model\\'s vocabulary size to the context window size."]', correct_answers: '["It restricts the maximum length of the prompt you can provide.", "It limits the maximum length of the response the model can generate.", "It represents the total sum of input tokens and output tokens for a single request."]', explanation: "The token limit (context window) restricts the combined length of the input prompt and the generated output. It does not dictate concurrent users or vocabulary size.", difficulty: 0.1, discrimination: 1.2, guessing: 0.25, time_estimate_seconds: 55});

// Intuitive (q015)
CREATE (q015:Question {id: "q-ai-llm-015", stem: "Why do subword tokenizers (like BPE) sometimes split a single English word into multiple tokens (e.g., 'unbelievable' into 'un', 'believ', 'able')?", level: "Intuitive", question_type: "mcq_multi", options: '["To handle rare or completely novel words by breaking them into recognizable components.", "To maintain a fixed and manageable overall vocabulary size.", "To allow the model to understand the morphological structure of words (prefixes, roots, suffixes).", "To intentionally slow down the model\\'s inference speed.", "Because the tokenizer ran out of memory to store long words."]', correct_answers: '["To handle rare or completely novel words by breaking them into recognizable components.", "To maintain a fixed and manageable overall vocabulary size.", "To allow the model to understand the morphological structure of words (prefixes, roots, suffixes)."]', explanation: "Subword tokenizers balance the need for a finite vocabulary size with the ability to represent any word. By breaking rare words into common subwords, they avoid 'out of vocabulary' errors and often capture morphological meaning.", difficulty: 1.1, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 65});

// Apply (q016)
CREATE (q016:Question {id: "q-ai-llm-016", stem: "You are designing an application that summarizes long legal documents using an LLM API charged by the token. Which strategies will effectively optimize token usage?", level: "Apply", question_type: "mcq_multi", options: '["Removing unnecessary whitespace, HTML tags, and boilerplate text before sending.", "Translating the document to a language with better tokenizer efficiency (like English) if appropriate.", "Using a smaller model that charges less per token.", "Replacing all words with their single-letter abbreviations.", "Encoding the text in Base64 before sending it to the model."]', correct_answers: '["Removing unnecessary whitespace, HTML tags, and boilerplate text before sending.", "Translating the document to a language with better tokenizer efficiency (like English) if appropriate.", "Using a smaller model that charges less per token."]', explanation: "Cleaning text and stripping boilerplate reduces token count. English is often more token-efficient. Choosing a cheaper model directly reduces costs. Base64 encoding actually increases token count significantly, and replacing all words with single letters ruins the semantic meaning.", difficulty: 1.8, discrimination: 1.7, guessing: 0.25, time_estimate_seconds: 70});

// --- c-ai-llm-003: Prompt Engineering ---
// Repeat (q017-q020)
CREATE (q017:Question {id: "q-ai-llm-017", stem: "Which of the following are common techniques used in prompt engineering?", level: "Repeat", question_type: "mcq_multi", options: '["Role-playing (e.g., \\"Act as a senior software engineer\\").", "Providing formatting instructions (e.g., \\"Output as a JSON array\\").", "Including explicit examples of desired inputs and outputs.", "Changing the physical hardware the model runs on.", "Modifying the model\\'s pre-training dataset."]', correct_answers: '["Role-playing (e.g., \\"Act as a senior software engineer\\").", "Providing formatting instructions (e.g., \\"Output as a JSON array\\").", "Including explicit examples of desired inputs and outputs."]', explanation: "Role-playing, formatting instructions, and few-shot examples are standard prompt engineering techniques. Changing hardware or pre-training data involves model engineering/training, not prompt engineering.", difficulty: -1.3, discrimination: 0.8, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q018:Question {id: "q-ai-llm-018", stem: "What is the primary purpose of a 'System Prompt' in conversational LLMs?", level: "Repeat", question_type: "mcq_multi", options: '["To set the overall behavior, persona, or constraints of the assistant.", "To provide a permanent set of instructions that apply to the entire conversation.", "To establish rules that the model should prioritize over user instructions.", "To automatically generate the user\\'s next question.", "To determine the billing rate for the API call."]', correct_answers: '["To set the overall behavior, persona, or constraints of the assistant.", "To provide a permanent set of instructions that apply to the entire conversation.", "To establish rules that the model should prioritize over user instructions."]', explanation: "The system prompt acts as a meta-instruction layer, setting the persona, constraints, and overarching rules that persist throughout the conversation session and often take precedence over conflicting user requests.", difficulty: -1.1, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 45});
CREATE (q019:Question {id: "q-ai-llm-019", stem: "What does 'Chain-of-Thought' (CoT) prompting entail?", level: "Repeat", question_type: "mcq_multi", options: '["Instructing the model to explain its reasoning step-by-step before giving the final answer.", "Adding phrases like \\"Let\\'s think step by step\\" to the prompt.", "Helping the model solve complex logic or math problems by breaking them down.", "Forcing the model to output a continuous stream of random thoughts.", "Linking multiple LLMs together in a sequence."]', correct_answers: '["Instructing the model to explain its reasoning step-by-step before giving the final answer.", "Adding phrases like \\"Let\\'s think step by step\\" to the prompt.", "Helping the model solve complex logic or math problems by breaking them down."]', explanation: "Chain-of-Thought involves prompting the model to generate intermediate reasoning steps before the final answer, often using phrases like 'Let\\'s think step by step', which significantly improves performance on complex reasoning tasks.", difficulty: -0.8, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 45});
CREATE (q020:Question {id: "q-ai-llm-020", stem: "What is 'Prompt Injection'?", level: "Repeat", question_type: "mcq_multi", options: '["A security vulnerability where malicious input overrides the original system instructions.", "A technique where a user tricks the AI into ignoring its safety guardrails.", "A method to inject new parameters into the neural network weights.", "An attack vector commonly used in user-facing LLM applications.", "A way to speed up the model\\'s inference time."]', correct_answers: '["A security vulnerability where malicious input overrides the original system instructions.", "A technique where a user tricks the AI into ignoring its safety guardrails.", "An attack vector commonly used in user-facing LLM applications."]', explanation: "Prompt injection is a vulnerability where malicious user input is crafted to hijack the model's instructions, bypassing guardrails or system prompts. It does not alter the model's weights or speed.", difficulty: -0.7, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 50});

// Summary (q021-q023)
CREATE (q021:Question {id: "q-ai-llm-021", stem: "How does Chain-of-Thought (CoT) prompting improve an LLM's accuracy on complex tasks?", level: "Summary", question_type: "mcq_multi", options: '["It forces the model to allocate more computational steps (tokens) to process the problem.", "It allows the model to build upon intermediate conclusions rather than guessing the final answer in one step.", "It makes the model\\'s reasoning process visible, making it easier to debug.", "It automatically connects the model to an external calculator or logic engine.", "It modifies the model\\'s internal weights in real-time."]', correct_answers: '["It forces the model to allocate more computational steps (tokens) to process the problem.", "It allows the model to build upon intermediate conclusions rather than guessing the final answer in one step.", "It makes the model\\'s reasoning process visible, making it easier to debug."]', explanation: "Because LLMs generate one token at a time, CoT gives the model more 'thinking space' (tokens) to arrive at the answer, allowing it to condition its final answer on the intermediate logical steps it just generated. It does not connect to external tools or change weights.", difficulty: 0.4, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q022:Question {id: "q-ai-llm-022", stem: "When asking an LLM to output strictly formatted data (like JSON), which strategies are most effective?", level: "Summary", question_type: "mcq_multi", options: '["Providing an explicit schema or template in the prompt.", "Using few-shot examples of the exact desired JSON format.", "Setting the model\\'s temperature to a lower value (e.g., 0.0) to increase determinism.", "Asking the model politely to please not include markdown.", "Setting the temperature to 1.0 to encourage creative formatting."]', correct_answers: '["Providing an explicit schema or template in the prompt.", "Using few-shot examples of the exact desired JSON format.", "Setting the model\\'s temperature to a lower value (e.g., 0.0) to increase determinism."]', explanation: "Strict formatting requires low variance (low temperature) and clear constraints (schemas and examples). High temperature encourages creative, non-deterministic output, which often breaks formatting. Polite requests are less effective than structural constraints.", difficulty: 0.1, discrimination: 1.2, guessing: 0.25, time_estimate_seconds: 55});
CREATE (q023:Question {id: "q-ai-llm-023", stem: "What makes a prompt vulnerable to 'Prompt Injection'?", level: "Summary", question_type: "mcq_multi", options: '["Concatenating untrusted user input directly with system instructions.", "Failing to clearly delineate where instructions end and user data begins.", "Using an LLM that cannot distinguish between system commands and user text.", "Using too high of a temperature setting.", "Encrypting the prompt before sending it."]', correct_answers: '["Concatenating untrusted user input directly with system instructions.", "Failing to clearly delineate where instructions end and user data begins.", "Using an LLM that cannot distinguish between system commands and user text."]', explanation: "Prompt injection occurs because LLMs process the entire prompt as a single sequence of text and cannot inherently distinguish trusted instructions from untrusted data, especially if they are poorly delineated.", difficulty: 0.5, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 60});

// Intuitive (q024-q025)
CREATE (q024:Question {id: "q-ai-llm-024", stem: "Why does assigning a persona (e.g., 'You are an expert astrophysicist') often improve the quality of an LLM's response?", level: "Intuitive", question_type: "mcq_multi", options: '["It shifts the model\\'s probability distribution toward vocabulary and concepts associated with that persona in its training data.", "It acts as a contextual anchor, helping the model avoid irrelevant generalizations.", "It signals to the model the desired level of expertise and tone.", "It literally gives the model an advanced degree in the specified field.", "It bypasses the model\\'s safety filters."]', correct_answers: '["It shifts the model\\'s probability distribution toward vocabulary and concepts associated with that persona in its training data.", "It acts as a contextual anchor, helping the model avoid irrelevant generalizations.", "It signals to the model the desired level of expertise and tone."]', explanation: "Assigning a persona conditions the model's token generation probabilities on subsets of its training data related to that persona, leading to more specialized vocabulary, appropriate tone, and relevant context.", difficulty: 1.3, discrimination: 1.6, guessing: 0.25, time_estimate_seconds: 65});
CREATE (q025:Question {id: "q-ai-llm-025", stem: "Why is 'telling the model what TO do' generally better than 'telling it what NOT to do' (negative prompting)?", level: "Intuitive", question_type: "mcq_multi", options: '["Negative constraints introduce the forbidden concepts into the context window, increasing their statistical likelihood.", "LLMs often struggle to consistently apply negation to long-range dependencies.", "Providing clear affirmative instructions creates a narrower, more predictable path for text generation.", "LLMs are programmed to rebel against negative instructions.", "Negative prompts use more tokens than positive prompts."]', correct_answers: '["Negative constraints introduce the forbidden concepts into the context window, increasing their statistical likelihood.", "LLMs often struggle to consistently apply negation to long-range dependencies.", "Providing clear affirmative instructions creates a narrower, more predictable path for text generation."]', explanation: "Mentioning what not to do puts those exact concepts into the context, raising their attention weights. LLMs also struggle with logic negations over long text. Affirmative instructions clearly guide the model to the desired probability space.", difficulty: 1.5, discrimination: 1.7, guessing: 0.25, time_estimate_seconds: 70});

// Apply (q026-q027)
CREATE (q026:Question {id: "q-ai-llm-026", stem: "You are building a customer service bot. How should you design the prompt to safely handle angry customer emails?", level: "Apply", question_type: "mcq_multi", options: '["Use a system prompt that mandates a calm, empathetic, and professional tone.", "Include explicit instructions to never mirror the customer\\'s anger or use profanity.", "Provide few-shot examples of angry customer emails paired with de-escalating, polite responses.", "Prompt the model to aggressively defend the company\\'s policies.", "Instruct the model to ignore the email if it contains negative words."]', correct_answers: '["Use a system prompt that mandates a calm, empathetic, and professional tone.", "Include explicit instructions to never mirror the customer\\'s anger or use profanity.", "Provide few-shot examples of angry customer emails paired with de-escalating, polite responses."]', explanation: "A robust prompt for this scenario uses system-level persona constraints, explicit boundaries against mirroring toxicity, and few-shot examples demonstrating the desired de-escalation behavior.", difficulty: 2.1, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 70});
CREATE (q027:Question {id: "q-ai-llm-027", stem: "You want an LLM to extract names and dates from a text and output ONLY valid JSON. How do you design a robust prompt template for production?", level: "Apply", question_type: "mcq_multi", options: '["Provide a JSON schema defining the required keys and data types.", "Include instructions like \\"Output strictly JSON. Do not include introductory text or markdown formatting.\\"", "Append the start of a JSON block (e.g., \\"{\\") at the very end of the prompt to force the completion.", "Set the temperature to 0 to minimize variations in output structure.", "Use a highly conversational tone to make the model feel comfortable."]', correct_answers: '["Provide a JSON schema defining the required keys and data types.", "Include instructions like \\"Output strictly JSON. Do not include introductory text or markdown formatting.\\"", "Append the start of a JSON block (e.g., \\"{\\") at the very end of the prompt to force the completion.", "Set the temperature to 0 to minimize variations in output structure."]', explanation: "Forcing strict JSON in production requires low temperature, explicit schema/instructions against conversational filler, and 'pre-filling' the assistant's response with a `{` to constrain its first generated token. Wait, there are 4 correct options here. Let's fix that to be exactly 2-3.", difficulty: 2.3, discrimination: 2.0, guessing: 0.25, time_estimate_seconds: 75});
// Correction to q027 options to ensure 2-3 correct answers:
// Correct options: Schema, Instructions, Temperature. Distractors: Conversational tone, High temperature.
MATCH (q:Question {id: "q-ai-llm-027"}) SET q.options = '["Provide a JSON schema defining the required keys and data types.", "Include instructions like \\"Output strictly JSON. Do not include introductory text.\\"", "Set the temperature to 0 to minimize variations in output structure.", "Use a highly conversational tone to make the model feel comfortable.", "Set the temperature to 1.5 to allow for structural flexibility."]', q.correct_answers = '["Provide a JSON schema defining the required keys and data types.", "Include instructions like \\"Output strictly JSON. Do not include introductory text.\\"", "Set the temperature to 0 to minimize variations in output structure."]';


// --- c-ai-llm-004: Few-shot / Zero-shot Learning ---
// Repeat (q028-q029)
CREATE (q028:Question {id: "q-ai-llm-028", stem: "What is 'Zero-shot' prompting?", level: "Repeat", question_type: "mcq_multi", options: '["Asking the model to perform a task without providing any explicit examples in the prompt.", "Relying entirely on the model\\'s pre-trained knowledge to answer.", "Providing a task description and immediately asking for the output.", "Providing multiple examples of the task before asking the question.", "Training the model from scratch on zero data."]', correct_answers: '["Asking the model to perform a task without providing any explicit examples in the prompt.", "Relying entirely on the model\\'s pre-trained knowledge to answer.", "Providing a task description and immediately asking for the output."]', explanation: "Zero-shot prompting implies giving the model instructions for a task without any input-output examples in the prompt, relying purely on its pre-existing instruction-following capabilities.", difficulty: -1.2, discrimination: 0.9, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q029:Question {id: "q-ai-llm-029", stem: "What characterizes 'Few-shot' prompting?", level: "Repeat", question_type: "mcq_multi", options: '["Including a small number of examples (demonstrations) of the task within the prompt.", "Helping the model understand the desired format and pattern of the output.", "Providing context that allows the model to learn the task \\"in-context\\".", "Fine-tuning the model\\'s weights using a small dataset.", "Giving the model a few seconds to think before responding."]', correct_answers: '["Including a small number of examples (demonstrations) of the task within the prompt.", "Helping the model understand the desired format and pattern of the output.", "Providing context that allows the model to learn the task \\"in-context\\"."]', explanation: "Few-shot prompting involves providing a few examples of the task within the prompt itself to demonstrate the expected logic and formatting, enabling 'in-context learning' without changing the model's weights.", difficulty: -1.0, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 40});

// Summary (q030-q031)
CREATE (q030:Question {id: "q-ai-llm-030", stem: "When is it most appropriate to use Few-shot prompting instead of Zero-shot prompting?", level: "Summary", question_type: "mcq_multi", options: '["When the desired output requires a very specific, non-standard format.", "When the task involves specialized logic that the model struggles with zero-shot.", "When you need the model to map specific inputs to arbitrary labels.", "When you want to minimize token usage and API costs.", "When the task is a simple, common factual question."]', correct_answers: '["When the desired output requires a very specific, non-standard format.", "When the task involves specialized logic that the model struggles with zero-shot.", "When you need the model to map specific inputs to arbitrary labels."]', explanation: "Few-shot is highly effective for enforcing specific formats, teaching niche logic patterns, and mapping inputs to custom labels that the model wouldn't naturally infer. It increases, rather than minimizes, token usage.", difficulty: 0.2, discrimination: 1.3, guessing: 0.25, time_estimate_seconds: 55});
CREATE (q031:Question {id: "q-ai-llm-031", stem: "What is a significant limitation of using too many examples in a Few-shot prompt?", level: "Summary", question_type: "mcq_multi", options: '["It consumes a large portion of the context window, leaving less room for the actual input.", "It increases the cost per API call due to higher token counts.", "It can cause the model to overfit to the specific examples provided and lose generalization.", "It permanently alters the model\\'s internal weights.", "It automatically converts the process into a fine-tuning job."]', correct_answers: '["It consumes a large portion of the context window, leaving less room for the actual input.", "It increases the cost per API call due to higher token counts.", "It can cause the model to overfit to the specific examples provided and lose generalization."]', explanation: "Providing too many examples uses up valuable context window space and increases costs. It can also bias the model too heavily toward the specific entities in the examples. It does not alter weights or trigger fine-tuning.", difficulty: 0.4, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 60});

// Intuitive (q032)
CREATE (q032:Question {id: "q-ai-llm-032", stem: "Why might a poorly constructed Few-shot example actually hurt model performance?", level: "Intuitive", question_type: "mcq_multi", options: '["LLMs are highly sensitive to the patterns in the prompt; contradictory examples will confuse the pattern-matching.", "If the examples contain factual errors, the model may mimic those errors in its output.", "If the examples do not perfectly align with the system instructions, the model receives conflicting signals.", "The model will permanently unlearn the correct information.", "The model will refuse to process any prompt that contains errors."]', correct_answers: '["LLMs are highly sensitive to the patterns in the prompt; contradictory examples will confuse the pattern-matching.", "If the examples contain factual errors, the model may mimic those errors in its output.", "If the examples do not perfectly align with the system instructions, the model receives conflicting signals."]', explanation: "In-context learning causes the model to heavily weight the patterns shown in the context. If examples are contradictory, factually wrong, or misaligned with instructions, the model will adopt those flaws. It does not cause permanent unlearning.", difficulty: 1.4, discrimination: 1.6, guessing: 0.25, time_estimate_seconds: 65});

// Apply (q033)
CREATE (q033:Question {id: "q-ai-llm-033", stem: "You are designing a few-shot prompt to classify customer reviews as 'Positive', 'Negative', or 'Neutral'. Which practices will yield the best results?", level: "Apply", question_type: "mcq_multi", options: '["Provide an equal or balanced number of examples for each class to avoid class bias.", "Ensure the examples are representative of the actual reviews the system will process in production.", "Use a consistent formatting delimiter between the input review and the output classification.", "Provide 100 examples of 'Positive' reviews and only 1 example of 'Negative'.", "Use random, unrelated text for the examples just to show the format."]', correct_answers: '["Provide an equal or balanced number of examples for each class to avoid class bias.", "Ensure the examples are representative of the actual reviews the system will process in production.", "Use a consistent formatting delimiter between the input review and the output classification."]', explanation: "Effective few-shot prompting requires balanced class representation (to avoid biasing the model), realistic data distributions, and clear, consistent formatting separators.", difficulty: 1.9, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 70});

// --- c-ai-llm-005: Temperature and Sampling ---
// Repeat (q034-q035)
CREATE (q034:Question {id: "q-ai-llm-034", stem: "What does the 'Temperature' parameter control in an LLM?", level: "Repeat", question_type: "mcq_multi", options: '["The randomness or creativity of the model\\'s responses.", "The scaling of the logits before the softmax function is applied.", "How likely the model is to choose lower-probability tokens.", "The physical heat generated by the GPUs during inference.", "The speed at which the model generates tokens."]', correct_answers: '["The randomness or creativity of the model\\'s responses.", "The scaling of the logits before the softmax function is applied.", "How likely the model is to choose lower-probability tokens."]', explanation: "Temperature scales the logits before softmax, flattening the probability distribution. Higher temperature increases randomness by making lower-probability tokens more likely to be selected. It does not affect hardware heat or inference speed.", difficulty: -1.1, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 45});
CREATE (q035:Question {id: "q-ai-llm-035", stem: "What does 'Top-P' (Nucleus Sampling) do?", level: "Repeat", question_type: "mcq_multi", options: '["It restricts token selection to a subset of tokens whose cumulative probability equals the parameter P.", "It dynamically adjusts the number of token options considered based on the probability distribution shape.", "It clips the long tail of highly unlikely tokens from being selected.", "It selects exactly the top P number of tokens to choose from.", "It changes the model\\'s internal vocabulary size."]', correct_answers: '["It restricts token selection to a subset of tokens whose cumulative probability equals the parameter P.", "It dynamically adjusts the number of token options considered based on the probability distribution shape.", "It clips the long tail of highly unlikely tokens from being selected."]', explanation: "Top-P (nucleus sampling) sorts tokens by probability and only considers the top tokens whose combined probabilities reach the threshold P. This dynamically clips the 'long tail' of unlikely tokens without fixing the number of candidates (which is what Top-K does).", difficulty: -0.9, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 50});

// Summary (q036-q037)
CREATE (q036:Question {id: "q-ai-llm-036", stem: "How do Temperature and Top-P interact when both are modified?", level: "Summary", question_type: "mcq_multi", options: '["They both influence the probability distribution of the next token selection.", "High temperature flattens the distribution, while low Top-P cuts off the flattened tail.", "It is generally recommended by API providers to alter only one of them at a time.", "They cancel each other out completely if set to the same value.", "Top-P controls formatting, while Temperature controls factual accuracy."]', correct_answers: '["They both influence the probability distribution of the next token selection.", "High temperature flattens the distribution, while low Top-P cuts off the flattened tail.", "It is generally recommended by API providers to alter only one of them at a time."]', explanation: "Both govern sampling. Temperature changes the shape of the probability curve, while Top-P truncates it. Because their effects overlap, it is standard practice to adjust one while leaving the other at its default.", difficulty: 0.3, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q037:Question {id: "q-ai-llm-037", stem: "What is the expected outcome of setting Temperature to 0?", level: "Summary", question_type: "mcq_multi", options: '["The model becomes mostly deterministic, nearly always selecting the most probable next token.", "The variance in responses across multiple identical requests is minimized.", "The model becomes highly suitable for tasks requiring strict formatting or factual recall.", "The model will generate completely random gibberish.", "The model will fail to output anything."]', correct_answers: '["The model becomes mostly deterministic, nearly always selecting the most probable next token.", "The variance in responses across multiple identical requests is minimized.", "The model becomes highly suitable for tasks requiring strict formatting or factual recall."]', explanation: "A temperature of 0 results in 'greedy decoding', where the model almost exclusively picks the highest probability token. This minimizes variance and is ideal for rigid, factual, or formatting tasks.", difficulty: 0.0, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 50});

// Intuitive (q038)
CREATE (q038:Question {id: "q-ai-llm-038", stem: "Even with Temperature set to 0.0, LLM outputs can sometimes vary slightly between identical calls. Why?", level: "Intuitive", question_type: "mcq_multi", options: '["Floating-point math in modern GPU clusters can have slight non-deterministic variations.", "Sparse attention mechanisms or optimizations like FlashAttention may introduce minor numerical differences.", "API load balancing might route requests to models running on different hardware architectures.", "The model naturally desires to be creative despite the settings.", "The temperature parameter is ignored by most modern APIs."]', correct_answers: '["Floating-point math in modern GPU clusters can have slight non-deterministic variations.", "Sparse attention mechanisms or optimizations like FlashAttention may introduce minor numerical differences.", "API load balancing might route requests to models running on different hardware architectures."]', explanation: "While Temperature 0 theoretically means deterministic greedy search, the physical reality of distributed GPU computing involves non-deterministic floating-point accumulations and optimizations (like FlashAttention), which can occasionally flip the top token choice if probabilities are extremely close.", difficulty: 1.6, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 70});

// Apply (q039-q040)
CREATE (q039:Question {id: "q-ai-llm-039", stem: "You are building a creative writing assistant that helps authors brainstorm plot twists. Which sampling settings are most appropriate?", level: "Apply", question_type: "mcq_multi", options: '["A relatively high Temperature (e.g., 0.8 - 1.2) to encourage diverse vocabulary and unexpected ideas.", "A Top-P near 1.0 to ensure the full spectrum of tokens is considered.", "A Temperature of 0.0 to ensure the plot makes logical sense.", "A Top-P of 0.1 to keep the ideas strictly conventional.", "A negative Temperature to force extreme creativity."]', correct_answers: '["A relatively high Temperature (e.g., 0.8 - 1.2) to encourage diverse vocabulary and unexpected ideas.", "A Top-P near 1.0 to ensure the full spectrum of tokens is considered."]', explanation: "Creative tasks benefit from higher temperatures and higher Top-P values, which allow the model to select lower-probability, more surprising tokens. Temperature 0 makes it too predictable, and negative temperature does not exist.", difficulty: 1.7, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q040:Question {id: "q-ai-llm-040", stem: "You are configuring an LLM to generate SQL queries from natural language questions. Which settings are optimal?", level: "Apply", question_type: "mcq_multi", options: '["Temperature = 0.0 to ensure deterministic and syntactically rigid outputs.", "A low Top-P value if you must use a higher temperature.", "Adding a small penalty for repetition to prevent infinite loops of formatting characters.", "Temperature = 1.0 so the model can invent new SQL commands.", "Temperature = 2.0 to ensure the fastest database execution."]', correct_answers: '["Temperature = 0.0 to ensure deterministic and syntactically rigid outputs.", "A low Top-P value if you must use a higher temperature.", "Adding a small penalty for repetition to prevent infinite loops of formatting characters."]', explanation: "Code generation (like SQL) requires strict adherence to syntax and logic, meaning low/zero temperature is ideal. If temperature is used, a low Top-P limits destructive hallucinations. Repetition penalties can sometimes help with formatting loops.", difficulty: 2.0, discrimination: 1.7, guessing: 0.25, time_estimate_seconds: 65});

// --- c-ai-llm-006: Context Windows ---
// Repeat (q041-q043)
CREATE (q041:Question {id: "q-ai-llm-041", stem: "What does the term 'Context Window' refer to in LLMs?", level: "Repeat", question_type: "mcq_multi", options: '["The maximum number of tokens the model can process and generate in a single request.", "The model\\'s short-term memory during a single interaction.", "The combined limit of the input prompt and the output completion.", "The size of the hard drive where the model is stored.", "The amount of historical data the model was trained on."]', correct_answers: '["The maximum number of tokens the model can process and generate in a single request.", "The model\\'s short-term memory during a single interaction.", "The combined limit of the input prompt and the output completion."]', explanation: "The context window is the maximum sequence length (input + output tokens) the model can handle at one time. It acts as the model's short-term working memory.", difficulty: -1.4, discrimination: 0.9, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q042:Question {id: "q-ai-llm-042", stem: "What happens if a prompt exceeds the model's maximum context window?", level: "Repeat", question_type: "mcq_multi", options: '["The API will typically return an error and refuse to process the request.", "The model will silently truncate the input, usually cutting off the earliest parts of the prompt.", "The generation might fail or produce incomplete outputs if there is no room left for the response.", "The model will automatically upgrade to a larger context window and charge you more.", "The model will compress the text automatically without data loss."]', correct_answers: '["The API will typically return an error and refuse to process the request.", "The model will silently truncate the input, usually cutting off the earliest parts of the prompt.", "The generation might fail or produce incomplete outputs if there is no room left for the response."]', explanation: "Depending on the implementation, exceeding the window either throws an API error, silently truncates the prompt, or leaves no room for output tokens. Models do not magically compress text losslessly or auto-upgrade without explicit configuration.", difficulty: -1.2, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 45});
CREATE (q043:Question {id: "q-ai-llm-043", stem: "Why is it computationally difficult to infinitely expand an LLM's context window?", level: "Repeat", question_type: "mcq_multi", options: '["Standard self-attention mechanisms scale quadratically with sequence length.", "Memory (VRAM) requirements grow rapidly as the context window increases.", "Processing very long contexts significantly increases latency (time to first token).", "There are not enough words in the English language to fill an infinite context.", "Hardware companies refuse to build larger GPUs."]', correct_answers: '["Standard self-attention mechanisms scale quadratically with sequence length.", "Memory (VRAM) requirements grow rapidly as the context window increases.", "Processing very long contexts significantly increases latency (time to first token)."]', explanation: "The core challenge is the quadratic scaling of the standard self-attention mechanism regarding compute and memory (VRAM), which also dramatically increases latency. It is a mathematical and hardware limitation, not a lack of words.", difficulty: -0.8, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 50});

// Summary (q044-q045)
CREATE (q044:Question {id: "q-ai-llm-044", stem: "How does relying on a massive context window (e.g., 1 million tokens) affect practical application performance?", level: "Summary", question_type: "mcq_multi", options: '["It significantly increases the financial cost per query.", "It increases the time it takes for the model to process the prompt and start generating.", "It guarantees that the model will perfectly recall every fact in the document.", "It allows you to bypass the need for external vector databases (RAG) in some use cases.", "It makes the model run significantly faster."]', correct_answers: '["It significantly increases the financial cost per query.", "It increases the time it takes for the model to process the prompt and start generating.", "It allows you to bypass the need for external vector databases (RAG) in some use cases."]', explanation: "Massive context windows are expensive and slow (high latency). While they can sometimes replace complex Retrieval-Augmented Generation (RAG) architectures by stuffing everything into the prompt, they absolutely do NOT guarantee perfect recall.", difficulty: 0.4, discrimination: 1.3, guessing: 0.25, time_estimate_seconds: 55});
CREATE (q045:Question {id: "q-ai-llm-045", stem: "What is the 'Lost in the Middle' phenomenon observed in LLMs with large context windows?", level: "Summary", question_type: "mcq_multi", options: '["Models tend to recall information perfectly if it is at the very beginning of the prompt.", "Models tend to recall information perfectly if it is at the very end of the prompt.", "Models frequently fail to retrieve or utilize relevant information located in the middle of a long prompt.", "Models automatically delete the middle tokens to save memory.", "Models translate the middle of the prompt into a different language."]', correct_answers: '["Models tend to recall information perfectly if it is at the very beginning of the prompt.", "Models tend to recall information perfectly if it is at the very end of the prompt.", "Models frequently fail to retrieve or utilize relevant information located in the middle of a long prompt."]', explanation: "The 'Lost in the Middle' phenomenon describes how LLMs are highly proficient at utilizing information at the extreme start or end of their context window, but performance drastically degrades for information buried in the middle.", difficulty: 0.5, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 60});

// Intuitive (q046-q047)
CREATE (q046:Question {id: "q-ai-llm-046", stem: "Why does the 'Lost in the Middle' problem occur architecturally or empirically in LLMs?", level: "Intuitive", question_type: "mcq_multi", options: '["Training data naturally features the most critical instructions at the beginning or end of documents.", "The attention mechanism gets 'distracted' and spreads its weights too thin over thousands of middle tokens.", "Recent recency bias: the tokens closest to the generation point have the strongest immediate influence.", "The model physically overwrites the middle tokens in its VRAM cache.", "The model is explicitly programmed to ignore the middle of the text."]', correct_answers: '["Training data naturally features the most critical instructions at the beginning or end of documents.", "The attention mechanism gets 'distracted' and spreads its weights too thin over thousands of middle tokens.", "Recent recency bias: the tokens closest to the generation point have the strongest immediate influence."]', explanation: "The problem stems from how models are trained (human texts usually put key info at the start/end) and how the attention mechanism dilutes over massive sequences, favoring the most recent tokens (end) or the primary anchoring instructions (beginning).", difficulty: 1.6, discrimination: 1.7, guessing: 0.25, time_estimate_seconds: 65});
CREATE (q047:Question {id: "q-ai-llm-047", stem: "If a model has a 128k token limit, why might a developer still choose to use a Retrieval-Augmented Generation (RAG) system instead of just dumping all documents into the prompt?", level: "Intuitive", question_type: "mcq_multi", options: '["To reduce latency and improve response times for the user.", "To minimize API costs, as passing 128k tokens for every query is extremely expensive.", "To mitigate the 'Lost in the Middle' phenomenon and improve retrieval accuracy.", "Because 128k tokens is not enough to hold a single paragraph of text.", "To ensure the model completely forgets the pre-training data."]', correct_answers: '["To reduce latency and improve response times for the user.", "To minimize API costs, as passing 128k tokens for every query is extremely expensive.", "To mitigate the 'Lost in the Middle' phenomenon and improve retrieval accuracy."]', explanation: "Even if a model supports huge contexts, RAG is often preferred because sending massive prompts is slow, expensive, and subject to degradation in recall accuracy for information in the middle of the prompt.", difficulty: 1.3, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 65});

// Apply (q048-q050)
CREATE (q048:Question {id: "q-ai-llm-048", stem: "You are building a summarization tool that must process documents longer than your model's context window. Which architectural approaches solve this?", level: "Apply", question_type: "mcq_multi", options: '["Map-Reduce: Chunk the document, summarize each chunk, then summarize the summaries.", "Refine: Summarize chunk 1, then pass that summary plus chunk 2 to generate a new summary, iterating through.", "Truncation: Simply cut off the document when it hits the limit and summarize what fits.", "Upsampling: Automatically invent new tokens to fill the missing data.", "Compression: Run the text through a standard zip file compressor before sending it to the LLM."]', correct_answers: '["Map-Reduce: Chunk the document, summarize each chunk, then summarize the summaries.", "Refine: Summarize chunk 1, then pass that summary plus chunk 2 to generate a new summary, iterating through.", "Truncation: Simply cut off the document when it hits the limit and summarize what fits."]', explanation: "Map-Reduce and Refine are standard architectures for handling long documents. Truncation is a brute-force approach but is technically a solution. LLMs cannot read standard zip files directly, and upsampling makes up fake data.", difficulty: 2.1, discrimination: 1.7, guessing: 0.25, time_estimate_seconds: 70});
CREATE (q049:Question {id: "q-ai-llm-049", stem: "You have a massive prompt containing system instructions, few-shot examples, and a large reference document. To mitigate 'Lost in the Middle', how should you order the prompt sections?", level: "Apply", question_type: "mcq_multi", options: '["Place the core system instructions and the most critical question at the very beginning and repeat them at the very end.", "Place the large reference document in the middle.", "Place the user\\'s specific query in the exact middle of the reference document.", "Randomly shuffle the paragraphs of the reference document.", "Place the reference document at the end, and the question at the beginning, never repeating."]', correct_answers: '["Place the core system instructions and the most critical question at the very beginning and repeat them at the very end.", "Place the large reference document in the middle."]', explanation: "To combat 'Lost in the Middle', critical information (instructions and the actual query) should bookend the prompt (start and end). The dense, less critical reference material should be relegated to the middle. Wait, I need 3 correct options. Let's adjust this.", difficulty: 2.4, discrimination: 1.9, guessing: 0.25, time_estimate_seconds: 75});
// Correction to q049 options to ensure 2-3 correct answers:
MATCH (q:Question {id: "q-ai-llm-049"}) SET q.options = '["Place the core system instructions and the most critical question at the very beginning and repeat them at the very end.", "Place the large reference document in the middle.", "Ensure the specific task or question is the last thing the model reads before generating.", "Place the user\\'s specific query in the exact middle of the reference document.", "Randomly shuffle the paragraphs of the reference document."]', q.correct_answers = '["Place the core system instructions and the most critical question at the very beginning and repeat them at the very end.", "Place the large reference document in the middle.", "Ensure the specific task or question is the last thing the model reads before generating."]';


CREATE (q050:Question {id: "q-ai-llm-050", stem: "When implementing chunking for a RAG system to stay within context limits, what is the purpose of 'chunk overlap'?", level: "Apply", question_type: "mcq_multi", options: '["To prevent cutting a sentence or concept in half, which would destroy its context.", "To ensure that semantic meaning that spans across the boundary of two chunks is preserved.", "To provide the retrieval model with broader context when calculating embeddings.", "To force the LLM to generate the same output twice.", "To artificially inflate the size of the vector database."]', correct_answers: '["To prevent cutting a sentence or concept in half, which would destroy its context.", "To ensure that semantic meaning that spans across the boundary of two chunks is preserved.", "To provide the retrieval model with broader context when calculating embeddings."]', explanation: "Chunk overlap ensures that concepts split across chunk boundaries maintain their surrounding context, improving embedding quality and ensuring the LLM has complete thoughts to reason over during generation.", difficulty: 2.2, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 70});

// Create relationships to Concepts
MATCH (c:Concept {id: "c-ai-llm-001"}), (q:Question) WHERE q.id STARTS WITH "q-ai-llm-00" AND toInteger(substring(q.id, 11)) >= 1 AND toInteger(substring(q.id, 11)) <= 10 CREATE (c)-[:CONTAINS]->(q);
MATCH (c:Concept {id: "c-ai-llm-002"}), (q:Question) WHERE q.id STARTS WITH "q-ai-llm-01" AND toInteger(substring(q.id, 11)) >= 11 AND toInteger(substring(q.id, 11)) <= 16 CREATE (c)-[:CONTAINS]->(q);
MATCH (c:Concept {id: "c-ai-llm-003"}), (q:Question) WHERE q.id STARTS WITH "q-ai-llm-0" AND toInteger(substring(q.id, 11)) >= 17 AND toInteger(substring(q.id, 11)) <= 27 CREATE (c)-[:CONTAINS]->(q);
MATCH (c:Concept {id: "c-ai-llm-004"}), (q:Question) WHERE q.id STARTS WITH "q-ai-llm-0" AND toInteger(substring(q.id, 11)) >= 28 AND toInteger(substring(q.id, 11)) <= 33 CREATE (c)-[:CONTAINS]->(q);
MATCH (c:Concept {id: "c-ai-llm-005"}), (q:Question) WHERE q.id STARTS WITH "q-ai-llm-0" AND toInteger(substring(q.id, 11)) >= 34 AND toInteger(substring(q.id, 11)) <= 40 CREATE (c)-[:CONTAINS]->(q);
MATCH (c:Concept {id: "c-ai-llm-006"}), (q:Question) WHERE q.id STARTS WITH "q-ai-llm-0" AND toInteger(substring(q.id, 11)) >= 41 AND toInteger(substring(q.id, 11)) <= 50 CREATE (c)-[:CONTAINS]->(q);

// Establish Prerequisites between difficulty levels within each concept
// This creates a learning path: Repeat -> Summary -> Intuitive -> Apply
// Include conditional probabilities for graph belief propagation
MATCH (q1:Question {level: "Repeat"}), (q2:Question {level: "Summary"})
WITH q1, q2
MATCH (c:Concept)-[:CONTAINS]->(q1), (c)-[:CONTAINS]->(q2)
MERGE (q1)-[:IS_PREREQUISITE_FOR {p_pass_given_pass: 0.8, p_pass_given_fail: 0.2}]->(q2);

MATCH (q2:Question {level: "Summary"}), (q3:Question {level: "Intuitive"})
WITH q2, q3
MATCH (c:Concept)-[:CONTAINS]->(q2), (c)-[:CONTAINS]->(q3)
MERGE (q2)-[:IS_PREREQUISITE_FOR {p_pass_given_pass: 0.75, p_pass_given_fail: 0.15}]->(q3);

MATCH (q3:Question {level: "Intuitive"}), (q4:Question {level: "Apply"})
WITH q3, q4
MATCH (c:Concept)-[:CONTAINS]->(q3), (c)-[:CONTAINS]->(q4)
MERGE (q3)-[:IS_PREREQUISITE_FOR {p_pass_given_pass: 0.7, p_pass_given_fail: 0.1}]->(q4);

// Cross-concept prerequisites (LLMs are prerequisite for Tokenization, Prompt Engineering, etc.)
MATCH (c1:Concept {id: "c-ai-llm-001"}), (c2:Concept {id: "c-ai-llm-002"})
MERGE (c1)-[:IS_PREREQUISITE_FOR {p_pass_given_pass: 0.8, p_pass_given_fail: 0.2}]->(c2);
MATCH (c1:Concept {id: "c-ai-llm-001"}), (c3:Concept {id: "c-ai-llm-003"})
MERGE (c1)-[:IS_PREREQUISITE_FOR {p_pass_given_pass: 0.8, p_pass_given_fail: 0.2}]->(c3);
MATCH (c3:Concept {id: "c-ai-llm-003"}), (c4:Concept {id: "c-ai-llm-004"})
MERGE (c3)-[:IS_PREREQUISITE_FOR {p_pass_given_pass: 0.75, p_pass_given_fail: 0.15}]->(c4);
MATCH (c1:Concept {id: "c-ai-llm-001"}), (c5:Concept {id: "c-ai-llm-005"})
MERGE (c1)-[:IS_PREREQUISITE_FOR {p_pass_given_pass: 0.7, p_pass_given_fail: 0.2}]->(c5);
MATCH (c2:Concept {id: "c-ai-llm-002"}), (c6:Concept {id: "c-ai-llm-006"})
MERGE (c2)-[:IS_PREREQUISITE_FOR {p_pass_given_pass: 0.75, p_pass_given_fail: 0.15}]->(c6);

