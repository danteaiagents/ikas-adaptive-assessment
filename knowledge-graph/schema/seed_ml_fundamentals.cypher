// --- c-ai-ml-006: Bias-Variance Tradeoff ---
// Repeat (q042-q044)
CREATE (q042:Question {id: "q-ai-ml-042", stem: "What does 'Bias' refer to in the context of the bias-variance tradeoff?", level: "Repeat", question_type: "mcq_multi", options: '["The error introduced by approximating a real-world problem with a simplified model.", "The tendency of a model to consistently learn the wrong underlying relationship (underfitting).", "The difference between the average prediction of our model and the correct value.", "The model\\’s sensitivity to small fluctuations in the training set.", "The demographic prejudice inherent in the training data."]', correct_answers: '["The error introduced by approximating a real-world problem with a simplified model.", "The tendency of a model to consistently learn the wrong underlying relationship (underfitting).", "The difference between the average prediction of our model and the correct value."]', explanation: "Bias is the error from simplifying assumptions. High bias leads to underfitting. (Note: statistical bias differs from societal bias).", difficulty: -1.2, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q043:Question {id: "q-ai-ml-043", stem: "What does 'Variance' refer to in the bias-variance tradeoff?", level: "Repeat", question_type: "mcq_multi", options: '["The error introduced by the model\\’s sensitivity to small fluctuations or noise in the training set.", "How much the predictions for a given point vary across different realizations of the model.", "A model\\’s tendency to overfit the training data.", "The constant baseline error that cannot be removed.", "The rigidness of a linear regression line."]', correct_answers: '["The error introduced by the model\\’s sensitivity to small fluctuations or noise in the training set.", "How much the predictions for a given point vary across different realizations of the model.", "A model\\’s tendency to overfit the training data."]', explanation: "Variance measures how wildly the model\\'s predictions change if trained on different subsets of data, indicating sensitivity to noise (overfitting).", difficulty: -1.1, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 45});
CREATE (q044:Question {id: "q-ai-ml-044", stem: "Which model characteristics are typically associated with High Bias?", level: "Repeat", question_type: "mcq_multi", options: '["Underfitting", "High training error and high test error", "Oversimplified assumptions (e.g., linear models on non-linear data)", "Memorizing the training data", "Excellent performance on training data but poor on test data"]', correct_answers: '["Underfitting", "High training error and high test error", "Oversimplified assumptions (e.g., linear models on non-linear data)"]', explanation: "High bias means the model is too simple, leading to underfitting and uniformly high error rates across all datasets.", difficulty: -0.9, discrimination: 1.2, guessing: 0.25, time_estimate_seconds: 40});

// Summary (q045-q046)
CREATE (q045:Question {id: "q-ai-ml-045", stem: "How does model complexity affect the Bias-Variance tradeoff?", level: "Summary", question_type: "mcq_multi", options: '["As complexity increases, bias typically decreases and variance increases.", "As complexity decreases, bias typically increases and variance decreases.", "There is usually an optimal sweet spot of complexity where total error is minimized.", "Increasing complexity always reduces total error.", "Decreasing complexity always reduces total error."]', correct_answers: '["As complexity increases, bias typically decreases and variance increases.", "As complexity decreases, bias typically increases and variance decreases.", "There is usually an optimal sweet spot of complexity where total error is minimized."]', explanation: "The tradeoff dictates that adding complexity lowers bias but raises variance. Optimal modeling finds the point where total error is minimized.", difficulty: 0.2, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 55});
CREATE (q046:Question {id: "q-ai-ml-046", stem: "What constitutes the 'Irreducible Error' in a predictive modeling task?", level: "Summary", question_type: "mcq_multi", options: '["The error caused by inherent noise in the problem itself.", "Error stemming from unobserved variables not present in the dataset.", "The theoretical minimum error bound that no model can surpass.", "The error caused by using the wrong algorithm.", "The error caused by overfitting."]', correct_answers: '["The error caused by inherent noise in the problem itself.", "Error stemming from unobserved variables not present in the dataset.", "The theoretical minimum error bound that no model can surpass."]', explanation: "Total Error = Bias^2 + Variance + Irreducible Error. Irreducible error is inherent noise that cannot be modeled away.", difficulty: 0.5, discrimination: 1.3, guessing: 0.25, time_estimate_seconds: 50});

// Intuitive (q047-q048)
CREATE (q047:Question {id: "q-ai-ml-047", stem: "Using a dartboard analogy where the bullseye is the true target, how would you visually describe a model with Low Bias and High Variance?", level: "Intuitive", question_type: "mcq_multi", options: '["The darts are widely scattered all over the board, but centered around the bullseye.", "The model correctly captures the general vicinity of the target but lacks consistency.", "The darts are tightly clustered together, but far away from the bullseye.", "The darts consistently hit the exact same spot in the top right corner.", "The darts always hit the bullseye perfectly."]', correct_answers: '["The darts are widely scattered all over the board, but centered around the bullseye.", "The model correctly captures the general vicinity of the target but lacks consistency."]', explanation: "Low bias means the average prediction is correct (centered around bullseye). High variance means predictions are inconsistent and spread out.", difficulty: 1.0, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q048:Question {id: "q-ai-ml-048", stem: "Why do ensemble methods like Bagging primarily reduce variance rather than bias?", level: "Intuitive", question_type: "mcq_multi", options: '["Because they average the predictions of multiple deep models, smoothing out individual erratic predictions.", "Because the base models used in bagging (like deep decision trees) already have low bias.", "Because averaging multiple models with high bias simply results in an ensemble with high bias.", "Because bagging systematically deletes features.", "Because bagging enforces simple linear relationships."]', correct_answers: '["Because they average the predictions of multiple deep models, smoothing out individual erratic predictions.", "Because the base models used in bagging (like deep decision trees) already have low bias.", "Because averaging multiple models with high bias simply results in an ensemble with high bias."]', explanation: "Bagging uses complex, unpruned trees (low bias, high variance). Averaging their predictions cancels out the variance, while maintaining the low bias.", difficulty: 1.4, discrimination: 1.6, guessing: 0.25, time_estimate_seconds: 65});

// Apply (q049-q050)
CREATE (q049:Question {id: "q-ai-ml-049", stem: "You are plotting a learning curve (Training Error and Validation Error vs. Training Set Size). Both errors plateau at a very high value and are close together. What is the diagnosis and solution?", level: "Apply", question_type: "mcq_multi", options: '["The model is suffering from High Bias (Underfitting).", "You should increase the complexity of the model (e.g., add polynomial features or use a deeper network).", "You should gather more training data.", "You should apply stronger regularisation.", "The model is suffering from High Variance."]', correct_answers: '["The model is suffering from High Bias (Underfitting).", "You should increase the complexity of the model (e.g., add polynomial features or use a deeper network)."]', explanation: "High and converging errors indicate underfitting (high bias). More data won\\'t help; the model needs more capacity (complexity).", difficulty: 2.2, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 70});
CREATE (q050:Question {id: "q-ai-ml-050", stem: "Your model has a very low training error (1%) but a high validation error (20%). Which of the following actions will help push the model toward the optimal tradeoff point?", level: "Apply", question_type: "mcq_multi", options: '["Increase L1 or L2 regularisation strength.", "Collect and use more training data.", "Reduce the number of features via feature selection or PCA.", "Use a more complex algorithm.", "Train the model for more iterations."]', correct_answers: '["Increase L1 or L2 regularisation strength.", "Collect and use more training data.", "Reduce the number of features via feature selection or PCA."]', explanation: "This is a classic high variance (overfitting) scenario. Regularisation, more data, and dimensionality reduction are the standard cures.", difficulty: 1.8, discrimination: 1.7, guessing: 0.25, time_estimate_seconds: 70});

