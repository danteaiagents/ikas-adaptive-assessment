// --- c-ai-ml-005: Ensemble Methods ---
// Repeat (q033-q035)
CREATE (q033:Question {id: "q-ai-ml-033", stem: "What is the core principle behind Ensemble Methods in machine learning?", level: "Repeat", question_type: "mcq_multi", options: '["Combining the predictions of multiple base models to produce a single, stronger model.", "Using the \'wisdom of the crowd\' to reduce variance and bias.", "Training a single deep neural network on multiple GPUs.", "Relying on a single perfectly tuned decision tree.", "Averaging out the errors made by individual weak learners."]', correct_answers: '["Combining the predictions of multiple base models to produce a single, stronger model.", "Using the \'wisdom of the crowd\' to reduce variance and bias.", "Averaging out the errors made by individual weak learners."]', explanation: "Ensembles combine multiple weak or base models to create a robust model with lower error rates.", difficulty: -1.3, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q034:Question {id: "q-ai-ml-034", stem: "Which of the following are distinct types of Ensemble Methods?", level: "Repeat", question_type: "mcq_multi", options: '["Bagging (Bootstrap Aggregating)", "Boosting", "Stacking", "K-Means Clustering", "Support Vector Machines"]', correct_answers: '["Bagging (Bootstrap Aggregating)", "Boosting", "Stacking"]', explanation: "Bagging, Boosting, and Stacking are the primary categories of ensemble learning.", difficulty: -1.0, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q035:Question {id: "q-ai-ml-035", stem: "How does the Random Forest algorithm work?", level: "Repeat", question_type: "mcq_multi", options: '["It builds multiple decision trees independently using bagged samples of the data.", "It selects a random subset of features at each split in the tree.", "It aggregates the predictions of all trees via majority voting or averaging.", "It trains trees sequentially, focusing on errors of previous trees.", "It uses deep neural networks as its base estimators."]', correct_answers: '["It builds multiple decision trees independently using bagged samples of the data.", "It selects a random subset of features at each split in the tree.", "It aggregates the predictions of all trees via majority voting or averaging."]', explanation: "Random forest is a Bagging technique that uses independent decision trees built on bootstrapped data and random feature subsets to reduce correlation.", difficulty: -0.8, discrimination: 1.2, guessing: 0.25, time_estimate_seconds: 45});

// Summary (q036-q037)
CREATE (q036:Question {id: "q-ai-ml-036", stem: "What is the primary difference between Bagging and Boosting?", level: "Summary", question_type: "mcq_multi", options: '["Bagging trains models in parallel, whereas Boosting trains models sequentially.", "Boosting assigns higher weights to instances misclassified by previous models, Bagging treats all instances equally.", "Bagging aims primarily to reduce variance, while Boosting aims to reduce bias.", "Bagging can only be used for regression, Boosting for classification.", "Boosting is always faster to train than Bagging."]', correct_answers: '["Bagging trains models in parallel, whereas Boosting trains models sequentially.", "Boosting assigns higher weights to instances misclassified by previous models, Bagging treats all instances equally.", "Bagging aims primarily to reduce variance, while Boosting aims to reduce bias."]', explanation: "Bagging (parallel) targets variance reduction. Boosting (sequential) targets bias reduction by iteratively correcting errors.", difficulty: 0.1, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 55});
CREATE (q037:Question {id: "q-ai-ml-037", stem: "What characterizes the 'Stacking' ensemble technique?", level: "Summary", question_type: "mcq_multi", options: '["It uses the predictions of several distinct base models as input features for a \'meta-model\'.", "It typically combines heterogeneous model types (e.g., a tree, an SVM, and a neural network).", "It leverages cross-validation to generate the training data for the meta-model.", "It merely averages the final probabilities without learning a new function.", "It relies exclusively on weak learners of the exact same type."]', correct_answers: '["It uses the predictions of several distinct base models as input features for a \'meta-model\'.", "It typically combines heterogeneous model types (e.g., a tree, an SVM, and a neural network).", "It leverages cross-validation to generate the training data for the meta-model."]', explanation: "Stacking involves training a meta-model on the cross-validated outputs of diverse base models.", difficulty: 0.4, discrimination: 1.3, guessing: 0.25, time_estimate_seconds: 55});

// Intuitive (q038-q039)
CREATE (q038:Question {id: "q-ai-ml-038", stem: "Why does Random Forest select only a random subset of features at each split?", level: "Intuitive", question_type: "mcq_multi", options: '["To ensure that the individual trees in the forest are de-correlated.", "To prevent a single heavily dominant feature from being chosen at the root of every tree.", "To increase the diversity of the ensemble, which reduces overall variance.", "To speed up the training of each individual tree.", "To increase the bias of the ensemble to prevent underfitting."]', correct_answers: '["To ensure that the individual trees in the forest are de-correlated.", "To prevent a single heavily dominant feature from being chosen at the root of every tree.", "To increase the diversity of the ensemble, which reduces overall variance."]', explanation: "Feature randomness de-correlates the trees, preventing strong features from dominating everywhere, which ensures the ensemble effectively reduces variance.", difficulty: 1.1, discrimination: 1.6, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q039:Question {id: "q-ai-ml-039", stem: "Why are Boosting algorithms (like Gradient Boosting) particularly prone to overfitting if not properly tuned?", level: "Intuitive", question_type: "mcq_multi", options: '["Because they sequentially focus on the hardest, most erroneous examples, which might just be noise or outliers.", "Because adding more trees continually decreases training error, potentially chasing noise.", "Because they have very low initial bias.", "Because they train in parallel and ignore the data distribution.", "Because they require massive neural networks to operate."]', correct_answers: '["Because they sequentially focus on the hardest, most erroneous examples, which might just be noise or outliers.", "Because adding more trees continually decreases training error, potentially chasing noise."]', explanation: "Boosting aggressively minimizes training errors. If run too long or too deeply, it will start modeling outliers and noise.", difficulty: 1.5, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 65});

// Apply (q040-q041)
CREATE (q040:Question {id: "q-ai-ml-040", stem: "You are competing in a Kaggle tabular data competition and want to squeeze out the maximum possible accuracy. Training time is not an issue. What approach is best?", level: "Apply", question_type: "mcq_multi", options: '["Train a diverse set of tuned models (XGBoost, Random Forest, Neural Networks) and use Stacking to combine them.", "Use a highly tuned Gradient Boosting algorithm (like LightGBM) with a low learning rate and early stopping.", "Train a single Decision Tree to maximum depth.", "Use a simple K-Nearest Neighbors model.", "Blend the probabilities of top-performing models using weighted averaging."]', correct_answers: '["Train a diverse set of tuned models (XGBoost, Random Forest, Neural Networks) and use Stacking to combine them.", "Use a highly tuned Gradient Boosting algorithm (like LightGBM) with a low learning rate and early stopping.", "Blend the probabilities of top-performing models using weighted averaging."]', explanation: "Stacking, blending, and heavily tuned Boosting algorithms represent the state-of-the-art for tabular data competitions where inference speed is less constrained.", difficulty: 2.1, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 70});
CREATE (q041:Question {id: "q-ai-ml-041", stem: "Your Random Forest model is severely overfitting the training data. Which hyperparameters should you adjust to regularize the model?", level: "Apply", question_type: "mcq_multi", options: '["Decrease the maximum depth of the trees (max_depth).", "Increase the minimum number of samples required to split an internal node (min_samples_split).", "Decrease the maximum number of features considered at each split (max_features).", "Increase the number of trees in the forest (n_estimators) to 100,000.", "Change the splitting criterion from Gini to Entropy."]', correct_answers: '["Decrease the maximum depth of the trees (max_depth).", "Increase the minimum number of samples required to split an internal node (min_samples_split).", "Decrease the maximum number of features considered at each split (max_features)."]', explanation: "Constraining the depth, increasing split thresholds, and reducing feature subsets restricts the complexity of individual trees, thus regularizing the ensemble.", difficulty: 1.9, discrimination: 1.7, guessing: 0.25, time_estimate_seconds: 70});

