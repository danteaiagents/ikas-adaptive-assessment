// 2. Subject and Topics
MATCH (s:Subject {id: "s-ai"})
CREATE (t:Topic {id: "t-ai-ml-fundamentals", name: "Machine Learning Fundamentals"});

MATCH (s:Subject {id: "s-ai"}), (t:Topic {id: "t-ai-ml-fundamentals"}) CREATE (s)-[:CONTAINS]->(t);

// 3. Concepts
CREATE (c1:Concept {id: "c-ai-ml-001", name: "Supervised vs Unsupervised Learning", description: "Understanding the difference between learning with and without labels."});
CREATE (c2:Concept {id: "c-ai-ml-002", name: "Model Evaluation & Metrics", description: "Metrics used to evaluate the performance of ML models."});
CREATE (c3:Concept {id: "c-ai-ml-003", name: "Overfitting & Regularisation", description: "Techniques to prevent models from memorizing training data."});
CREATE (c4:Concept {id: "c-ai-ml-004", name: "Feature Engineering", description: "Process of using domain knowledge to extract features from raw data."});
CREATE (c5:Concept {id: "c-ai-ml-005", name: "Ensemble Methods", description: "Combining multiple learning algorithms to obtain better predictive performance."});
CREATE (c6:Concept {id: "c-ai-ml-006", name: "Bias-Variance Tradeoff", description: "The property of a set of predictive models whereby models with a lower bias in parameter estimation have a higher variance of the parameter estimates."});

MATCH (t:Topic {id: "t-ai-ml-fundamentals"}), (c:Concept) WHERE c.id STARTS WITH 'c-ai-ml-' CREATE (t)-[:CONTAINS]->(c);

MATCH (cc_theory:ConceptClass {id: "cc-theory"}), (cc_tech:ConceptClass {id: "cc-technique"})
MATCH (c1:Concept {id: "c-ai-ml-001"}), (c2:Concept {id: "c-ai-ml-002"}), (c3:Concept {id: "c-ai-ml-003"}), (c4:Concept {id: "c-ai-ml-004"}), (c5:Concept {id: "c-ai-ml-005"}), (c6:Concept {id: "c-ai-ml-006"})
CREATE (c1)-[:INSTANCE_OF]->(cc_theory),
       (c2)-[:INSTANCE_OF]->(cc_tech),
       (c3)-[:INSTANCE_OF]->(cc_tech),
       (c4)-[:INSTANCE_OF]->(cc_tech),
       (c5)-[:INSTANCE_OF]->(cc_tech),
       (c6)-[:INSTANCE_OF]->(cc_theory);

// Concept Prerequisites
MATCH (c1:Concept {id: "c-ai-ml-001"}), (c2:Concept {id: "c-ai-ml-002"}), (c3:Concept {id: "c-ai-ml-003"}), (c4:Concept {id: "c-ai-ml-004"}), (c5:Concept {id: "c-ai-ml-005"}), (c6:Concept {id: "c-ai-ml-006"})
CREATE (c1)-[:IS_PREREQUISITE_FOR]->(c2),
       (c1)-[:IS_PREREQUISITE_FOR]->(c4),
       (c2)-[:IS_PREREQUISITE_FOR]->(c3),
       (c3)-[:IS_PREREQUISITE_FOR]->(c5),
       (c3)-[:IS_PREREQUISITE_FOR]->(c6);

// Resource links
CREATE (r1:Resource {id: "r-c-ai-ml-001", url: "https://www.example.com/ml-1", type: "video", title: "Intro to Supervised vs Unsupervised"});
CREATE (r2:Resource {id: "r-c-ai-ml-002", url: "https://www.example.com/ml-2", type: "article", title: "Model Evaluation Metrics Guide"});
CREATE (r3:Resource {id: "r-c-ai-ml-003", url: "https://www.example.com/ml-3", type: "video", title: "Understanding Overfitting"});
CREATE (r4:Resource {id: "r-c-ai-ml-004", url: "https://www.example.com/ml-4", type: "article", title: "Feature Engineering Best Practices"});
CREATE (r5:Resource {id: "r-c-ai-ml-005", url: "https://www.example.com/ml-5", type: "video", title: "Ensemble Learning Explained"});
CREATE (r6:Resource {id: "r-c-ai-ml-006", url: "https://www.example.com/ml-6", type: "article", title: "Demystifying Bias-Variance Tradeoff"});

MATCH (c1:Concept {id: "c-ai-ml-001"}), (r1:Resource {id: "r-c-ai-ml-001"}) CREATE (c1)-[:LINKED_RESOURCE]->(r1);
MATCH (c2:Concept {id: "c-ai-ml-002"}), (r2:Resource {id: "r-c-ai-ml-002"}) CREATE (c2)-[:LINKED_RESOURCE]->(r2);
MATCH (c3:Concept {id: "c-ai-ml-003"}), (r3:Resource {id: "r-c-ai-ml-003"}) CREATE (c3)-[:LINKED_RESOURCE]->(r3);
MATCH (c4:Concept {id: "c-ai-ml-004"}), (r4:Resource {id: "r-c-ai-ml-004"}) CREATE (c4)-[:LINKED_RESOURCE]->(r4);
MATCH (c5:Concept {id: "c-ai-ml-005"}), (r5:Resource {id: "r-c-ai-ml-005"}) CREATE (c5)-[:LINKED_RESOURCE]->(r5);
MATCH (c6:Concept {id: "c-ai-ml-006"}), (r6:Resource {id: "r-c-ai-ml-006"}) CREATE (c6)-[:LINKED_RESOURCE]->(r6);

// 4. Generate 50 questions
// --- c-ai-ml-001: Supervised vs Unsupervised Learning ---
// Repeat (q001-q003)
CREATE (q001:Question {id: "q-ai-ml-001", stem: "Which of the following are primary characteristics of supervised learning algorithms?", level: "Repeat", question_type: "mcq_multi", options: '["They require labeled training data.", "They infer patterns from datasets without reference to known outcomes.", "They map an input to an output based on example input-output pairs.", "They are used exclusively for grouping unlabelled data.", "They typically involve a loss function to measure prediction error."]', correct_answers: '["They require labeled training data.", "They map an input to an output based on example input-output pairs.", "They typically involve a loss function to measure prediction error."]', explanation: "Supervised learning relies on labeled datasets to train algorithms to classify data or predict outcomes accurately. It maps inputs to outputs using pairs and minimizes error.", difficulty: -1.2, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 45});
CREATE (q002:Question {id: "q-ai-ml-002", stem: "Identify the algorithms that are commonly classified as unsupervised learning.", level: "Repeat", question_type: "mcq_multi", options: '["Linear Regression", "K-Means Clustering", "Support Vector Machines", "Principal Component Analysis (PCA)", "Random Forest"]', correct_answers: '["K-Means Clustering", "Principal Component Analysis (PCA)"]', explanation: "K-Means and PCA do not require labeled targets, making them unsupervised learning algorithms for clustering and dimensionality reduction respectively.", difficulty: -1.0, discrimination: 1.2, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q003:Question {id: "q-ai-ml-003", stem: "What tasks are typically solved using supervised learning?", level: "Repeat", question_type: "mcq_multi", options: '["Spam detection in emails", "Predicting housing prices", "Customer segmentation based on purchasing behavior", "Dimensionality reduction for visualization", "Medical diagnosis classification"]', correct_answers: '["Spam detection in emails", "Predicting housing prices", "Medical diagnosis classification"]', explanation: "Classification (spam, diagnosis) and regression (house prices) are supervised tasks. Segmentation and dimensionality reduction are unsupervised.", difficulty: -0.8, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 45});

// Summary (q004-q005)
CREATE (q004:Question {id: "q-ai-ml-004", stem: "How do supervised and unsupervised learning differ in their handling of data and objectives?", level: "Summary", question_type: "mcq_multi", options: '["Supervised learning uses a ground truth to guide the algorithm, unsupervised does not.", "Unsupervised learning aims to find hidden structures or data distributions.", "Supervised learning requires less data preparation than unsupervised learning.", "Unsupervised models can automatically label their own training data.", "Supervised models are optimized to predict target variables on unseen data."]', correct_answers: '["Supervised learning uses a ground truth to guide the algorithm, unsupervised does not.", "Unsupervised learning aims to find hidden structures or data distributions.", "Supervised models are optimized to predict target variables on unseen data."]', explanation: "Supervised learning uses ground truth labels to predict targets on new data, while unsupervised learning discovers hidden structure without labels.", difficulty: 0.0, discrimination: 1.3, guessing: 0.25, time_estimate_seconds: 50});
CREATE (q005:Question {id: "q-ai-ml-005", stem: "Which statements correctly describe the limitations of supervised and unsupervised learning approaches?", level: "Summary", question_type: "mcq_multi", options: '["Supervised learning is often limited by the availability and cost of labeled data.", "Unsupervised learning always converges to a globally optimal solution.", "It can be difficult to evaluate the success of unsupervised learning models objectively.", "Supervised learning cannot be used for categorical data.", "Unsupervised models struggle with dimensionality cursors without prior feature selection."]', correct_answers: '["Supervised learning is often limited by the availability and cost of labeled data.", "It can be difficult to evaluate the success of unsupervised learning models objectively.", "Unsupervised models struggle with dimensionality cursors without prior feature selection."]', explanation: "Supervised learning\'s bottleneck is labeled data. Unsupervised learning lacks clear ground truth for evaluation and can suffer in high dimensions.", difficulty: 0.3, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 55});

// Intuitive (q006)
CREATE (q006:Question {id: "q-ai-ml-006", stem: "Why is clustering considered an unsupervised learning task?", level: "Intuitive", question_type: "mcq_multi", options: '["Because the algorithm defines the groups without prior knowledge of what the groups should be.", "Because the user provides the exact cluster centers before training.", "Because it relies on analyzing the intrinsic distance or similarity between data points.", "Because it requires a validation dataset to measure accuracy.", "Because the objective function does not include a penalty for misclassification against a label."]', correct_answers: '["Because the algorithm defines the groups without prior knowledge of what the groups should be.", "Because it relies on analyzing the intrinsic distance or similarity between data points.", "Because the objective function does not include a penalty for misclassification against a label."]', explanation: "Clustering is unsupervised because it groups data based on intrinsic metrics (like distance) without reference to predefined labels or misclassification penalties.", difficulty: 1.0, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 60});

// Apply (q007-q008)
CREATE (q007:Question {id: "q-ai-ml-007", stem: "You are tasked with building a system to detect fraudulent credit card transactions. You have millions of past transactions, but only 0.1% are confirmed as fraud. Which approaches are suitable?", level: "Apply", question_type: "mcq_multi", options: '["Train a supervised classification model on the imbalanced dataset using appropriate sampling techniques.", "Use unsupervised anomaly detection to flag transactions that deviate significantly from normal patterns.", "Use a simple K-Means algorithm to create two equal-sized clusters for Fraud and Non-Fraud.", "Train a supervised regression model to predict the exact dollar amount of fraud.", "Combine unsupervised feature extraction with a supervised classifier."]', correct_answers: '["Train a supervised classification model on the imbalanced dataset using appropriate sampling techniques.", "Use unsupervised anomaly detection to flag transactions that deviate significantly from normal patterns.", "Combine unsupervised feature extraction with a supervised classifier."]', explanation: "Fraud detection can use supervised learning (handling imbalance), unsupervised anomaly detection (since fraud is rare), or a hybrid approach.", difficulty: 2.0, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 70});
CREATE (q008:Question {id: "q-ai-ml-008", stem: "A retail company wants to recommend products to users based on their browsing history, but they have no explicit ratings. How should they formulate this problem?", level: "Apply", question_type: "mcq_multi", options: '["As a supervised regression task predicting a 1-5 star rating.", "As an unsupervised task using association rules (e.g., market basket analysis).", "As a supervised classification task where predicting \'purchased vs not purchased\' serves as implicit feedback.", "As a clustering task to group users with similar behaviors and recommend items popular in their cluster.", "As an image classification task based on product photos."]', correct_answers: '["As an unsupervised task using association rules (e.g., market basket analysis).", "As a supervised classification task where predicting \'purchased vs not purchased\' serves as implicit feedback.", "As a clustering task to group users with similar behaviors and recommend items popular in their cluster."]', explanation: "Without explicit ratings, implicit feedback (purchases) can be used for supervised classification, or unsupervised methods like association rules and user clustering can be applied.", difficulty: 1.8, discrimination: 1.7, guessing: 0.25, time_estimate_seconds: 70});

// Prereqs for Concept 1
MATCH (q1:Question {id: "q-ai-ml-001"}), (q2:Question {id: "q-ai-ml-004"}) CREATE (q1)-[:IS_PREREQUISITE_FOR]->(q2);
MATCH (q4:Question {id: "q-ai-ml-004"}), (q6:Question {id: "q-ai-ml-006"}) CREATE (q4)-[:IS_PREREQUISITE_FOR]->(q6);
MATCH (q6:Question {id: "q-ai-ml-006"}), (q7:Question {id: "q-ai-ml-007"}) CREATE (q6)-[:IS_PREREQUISITE_FOR]->(q7);


// --- c-ai-ml-002: Model Evaluation & Metrics ---
// Repeat (q009-q011)
CREATE (q009:Question {id: "q-ai-ml-009", stem: "Which of the following metrics are commonly used to evaluate a regression model?", level: "Repeat", question_type: "mcq_multi", options: '["Mean Squared Error (MSE)", "F1 Score", "Mean Absolute Error (MAE)", "R-squared (R²)", "Area Under the ROC Curve (AUC)"]', correct_answers: '["Mean Squared Error (MSE)", "Mean Absolute Error (MAE)", "R-squared (R²)"]', explanation: "MSE, MAE, and R-squared are standard metrics for regression. F1 Score and AUC are used for classification.", difficulty: -1.4, discrimination: 0.9, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q010:Question {id: "q-ai-ml-010", stem: "In binary classification, what does 'Recall' (Sensitivity) measure?", level: "Repeat", question_type: "mcq_multi", options: '["The proportion of actual positives that were identified correctly.", "True Positives / (True Positives + False Negatives)", "The proportion of positive identifications that were actually correct.", "True Positives / (True Positives + False Positives)", "The overall accuracy of the model across all classes."]', correct_answers: '["The proportion of actual positives that were identified correctly.", "True Positives / (True Positives + False Negatives)"]', explanation: "Recall measures the model\\'s ability to find all actual positive cases. Precision measures the correctness of positive predictions.", difficulty: -1.1, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 45});
CREATE (q011:Question {id: "q-ai-ml-011", stem: "What is the F1 Score?", level: "Repeat", question_type: "mcq_multi", options: '["The arithmetic mean of Precision and Recall.", "The harmonic mean of Precision and Recall.", "A metric that balances False Positives and False Negatives, especially in imbalanced datasets.", "A metric used strictly for multi-class regression.", "2 * (Precision * Recall) / (Precision + Recall)"]', correct_answers: '["The harmonic mean of Precision and Recall.", "A metric that balances False Positives and False Negatives, especially in imbalanced datasets.", "2 * (Precision * Recall) / (Precision + Recall)"]', explanation: "The F1 score is the harmonic mean of precision and recall, providing a balanced metric for imbalanced classification tasks.", difficulty: -0.9, discrimination: 1.2, guessing: 0.25, time_estimate_seconds: 45});

// Summary (q012-q013)
CREATE (q012:Question {id: "q-ai-ml-012", stem: "Why is Accuracy often a misleading metric for highly imbalanced datasets?", level: "Summary", question_type: "mcq_multi", options: '["Because a model can achieve high accuracy simply by always predicting the majority class.", "Because accuracy does not account for the severity of False Negatives vs False Positives.", "Because accuracy cannot be computed if one class is missing.", "Because accuracy requires continuous variables.", "Because accuracy obscures performance on the minority class, which is often the class of interest."]', correct_answers: '["Because a model can achieve high accuracy simply by always predicting the majority class.", "Because accuracy does not account for the severity of False Negatives vs False Positives.", "Because accuracy obscures performance on the minority class, which is often the class of interest."]', explanation: "In imbalanced datasets, high accuracy can mask poor performance on the minority class, and it ignores the varying costs of different error types.", difficulty: 0.1, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 50});
CREATE (q013:Question {id: "q-ai-ml-013", stem: "What does the Receiver Operating Characteristic (ROC) curve illustrate?", level: "Summary", question_type: "mcq_multi", options: '["The trade-off between the True Positive Rate and the False Positive Rate.", "The performance of a classification model at all classification thresholds.", "The direct relationship between Precision and Recall.", "The mean squared error across different epochs.", "How the model\\’s predictions vary as the decision boundary shifts."]', correct_answers: '["The trade-off between the True Positive Rate and the False Positive Rate.", "The performance of a classification model at all classification thresholds.", "How the model\\’s predictions vary as the decision boundary shifts."]', explanation: "The ROC curve plots TPR vs FPR across various threshold settings, illustrating how shifting the decision boundary affects classification performance.", difficulty: 0.4, discrimination: 1.3, guessing: 0.25, time_estimate_seconds: 55});

// Intuitive (q014-q015)
CREATE (q014:Question {id: "q-ai-ml-014", stem: "When evaluating a medical test for a fatal, highly contagious disease, why might you prioritize Recall over Precision?", level: "Intuitive", question_type: "mcq_multi", options: '["Because a False Negative (missing a sick patient) has catastrophic consequences.", "Because it is better to have a False Positive and run further tests than to let a sick patient go untreated.", "Because Precision only matters for benign diseases.", "Because maximizing Recall guarantees an accuracy of 100%.", "Because capturing every positive case is the absolute priority in this scenario."]', correct_answers: '["Because a False Negative (missing a sick patient) has catastrophic consequences.", "Because it is better to have a False Positive and run further tests than to let a sick patient go untreated.", "Because capturing every positive case is the absolute priority in this scenario."]', explanation: "High recall ensures very few false negatives. For fatal diseases, missing a diagnosis is much worse than a false alarm (false positive).", difficulty: 1.1, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q015:Question {id: "q-ai-ml-015", stem: "Why might a model have an excellent AUC-ROC score but a poor Precision-Recall (PR) curve on the same dataset?", level: "Intuitive", question_type: "mcq_multi", options: '["The dataset is highly imbalanced, with a massive number of True Negatives.", "The False Positive Rate (FPR) in ROC is pulled down by a large number of negative instances, hiding the false positives.", "AUC-ROC is calculated incorrectly for classification.", "The PR curve focuses specifically on the positive minority class, exposing poor precision.", "Because the model is actually a regression model."]', correct_answers: '["The dataset is highly imbalanced, with a massive number of True Negatives.", "The False Positive Rate (FPR) in ROC is pulled down by a large number of negative instances, hiding the false positives.", "The PR curve focuses specifically on the positive minority class, exposing poor precision."]', explanation: "In highly imbalanced datasets with many negatives, a large number of True Negatives keeps FPR low, artificially inflating ROC AUC. PR curves ignore True Negatives and expose poor precision.", difficulty: 1.4, discrimination: 1.6, guessing: 0.25, time_estimate_seconds: 65});

// Apply (q016)
CREATE (q016:Question {id: "q-ai-ml-016", stem: "You are building a spam filter. A false positive means a crucial work email goes to the spam folder. A false negative means spam reaches the inbox. How do you tune the model?", level: "Apply", question_type: "mcq_multi", options: '["Tune the classification threshold to maximize Precision.", "Accept a lower Recall to ensure that very few legitimate emails are misclassified.", "Optimize strictly for the F1 score.", "Tune the threshold to minimize False Positives.", "Maximize Recall to catch absolutely all spam."]', correct_answers: '["Tune the classification threshold to maximize Precision.", "Accept a lower Recall to ensure that very few legitimate emails are misclassified.", "Tune the threshold to minimize False Positives."]', explanation: "Since false positives (missing work emails) are highly costly, the model should prioritize Precision (minimizing false positives) over Recall.", difficulty: 2.1, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 70});

// Prereqs for Concept 2
MATCH (q9:Question {id: "q-ai-ml-009"}), (q12:Question {id: "q-ai-ml-012"}) CREATE (q9)-[:IS_PREREQUISITE_FOR]->(q12);
MATCH (q12:Question {id: "q-ai-ml-012"}), (q14:Question {id: "q-ai-ml-014"}) CREATE (q12)-[:IS_PREREQUISITE_FOR]->(q14);
MATCH (q14:Question {id: "q-ai-ml-014"}), (q16:Question {id: "q-ai-ml-016"}) CREATE (q14)-[:IS_PREREQUISITE_FOR]->(q16);

// --- c-ai-ml-003: Overfitting & Regularisation ---
// Repeat (q017-q019)
CREATE (q017:Question {id: "q-ai-ml-017", stem: "What defines an overfitted machine learning model?", level: "Repeat", question_type: "mcq_multi", options: '["It performs extremely well on the training data but poorly on unseen test data.", "It has memorized the noise and specific patterns of the training set.", "It generalizes perfectly to new data.", "It is usually too simple to capture the underlying data distribution.", "It has a high variance and low bias."]', correct_answers: '["It performs extremely well on the training data but poorly on unseen test data.", "It has memorized the noise and specific patterns of the training set.", "It has a high variance and low bias."]', explanation: "Overfitting occurs when a complex model memorizes training data (including noise), leading to high variance, low bias, and poor generalization to new data.", difficulty: -1.3, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q018:Question {id: "q-ai-ml-018", stem: "Which of the following are common regularisation techniques?", level: "Repeat", question_type: "mcq_multi", options: '["L1 Regularisation (Lasso)", "L2 Regularisation (Ridge)", "Dropout (in neural networks)", "Increasing model complexity", "Early Stopping"]', correct_answers: '["L1 Regularisation (Lasso)", "L2 Regularisation (Ridge)", "Dropout (in neural networks)", "Early Stopping"]', explanation: "L1, L2, Dropout, and Early Stopping are all techniques to constrain models and prevent overfitting. Increasing complexity causes overfitting.", difficulty: -1.0, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q019:Question {id: "q-ai-ml-019", stem: "How does L1 Regularisation (Lasso) differ from L2 Regularisation (Ridge)?", level: "Repeat", question_type: "mcq_multi", options: '["L1 adds the absolute value of magnitude of coefficients as a penalty term.", "L2 adds the squared magnitude of coefficients as a penalty term.", "L1 can lead to sparse models by shrinking some coefficients to exactly zero.", "L2 forces all coefficients to zero.", "L1 is only used in classification."]', correct_answers: '["L1 adds the absolute value of magnitude of coefficients as a penalty term.", "L2 adds the squared magnitude of coefficients as a penalty term.", "L1 can lead to sparse models by shrinking some coefficients to exactly zero."]', explanation: "L1 uses absolute magnitude and can yield sparse features (feature selection). L2 uses squared magnitude and shrinks coefficients but rarely to exactly zero.", difficulty: -0.8, discrimination: 1.2, guessing: 0.25, time_estimate_seconds: 45});

// Summary (q020-q021)
CREATE (q020:Question {id: "q-ai-ml-020", stem: "How does 'Early Stopping' prevent overfitting during the training of iterative algorithms like neural networks?", level: "Summary", question_type: "mcq_multi", options: '["It monitors the validation loss and stops training when the validation loss begins to increase.", "It prevents the model weights from growing too large by halting updates.", "It stops the training before the model has a chance to memorize the training noise.", "It deletes random neurons during the training process.", "It automatically applies L2 regularisation."]', correct_answers: '["It monitors the validation loss and stops training when the validation loss begins to increase.", "It prevents the model weights from growing too large by halting updates.", "It stops the training before the model has a chance to memorize the training noise."]', explanation: "Early stopping monitors validation loss; when it degrades while training loss improves, training halts, preventing the model from over-optimizing on training noise.", difficulty: 0.2, discrimination: 1.3, guessing: 0.25, time_estimate_seconds: 50});
CREATE (q021:Question {id: "q-ai-ml-021", stem: "What is the primary mechanism by which Dropout prevents overfitting in neural networks?", level: "Summary", question_type: "mcq_multi", options: '["By randomly ignoring a subset of neurons during each training pass.", "By preventing complex co-adaptations among neurons.", "By acting as an implicit ensemble of many smaller neural networks.", "By changing the loss function directly.", "By increasing the learning rate exponentially."]', correct_answers: '["By randomly ignoring a subset of neurons during each training pass.", "By preventing complex co-adaptations among neurons.", "By acting as an implicit ensemble of many smaller neural networks."]', explanation: "Dropout randomly zeroes out neurons during training, which forces the network to learn robust features rather than relying on specific neuron co-adaptations.", difficulty: 0.5, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 55});

// Intuitive (q022-q023)
CREATE (q022:Question {id: "q-ai-ml-022", stem: "Why does getting more training data often solve overfitting?", level: "Intuitive", question_type: "mcq_multi", options: '["More data provides a better representation of the true underlying population distribution.", "It makes it harder for a highly complex model to memorize all individual data points.", "It naturally forces the model to learn the general signal rather than specific noise.", "It automatically reduces the number of features.", "It explicitly changes the model\\’s hyperparameter settings."]', correct_answers: '["More data provides a better representation of the true underlying population distribution.", "It makes it harder for a highly complex model to memorize all individual data points.", "It naturally forces the model to learn the general signal rather than specific noise."]', explanation: "More data exposes the model to a wider variety of cases, preventing it from memorizing specific noisy examples and forcing it to generalize.", difficulty: 1.2, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q023:Question {id: "q-ai-ml-023", stem: "If you apply too much regularisation (e.g., a very high penalty lambda in Ridge), what is the likely outcome?", level: "Intuitive", question_type: "mcq_multi", options: '["The model will underfit the data.", "The model will suffer from high bias and low variance.", "The model coefficients will be heavily constrained, limiting its ability to capture the data\\’s complexity.", "The model will become perfectly generalized.", "The model will completely overfit the validation set."]', correct_answers: '["The model will underfit the data.", "The model will suffer from high bias and low variance.", "The model coefficients will be heavily constrained, limiting its ability to capture the data\\’s complexity."]', explanation: "Excessive regularisation restricts the model so much that it cannot even capture the true signal, leading to underfitting (high bias).", difficulty: 1.3, discrimination: 1.6, guessing: 0.25, time_estimate_seconds: 60});

// Apply (q024)
CREATE (q024:Question {id: "q-ai-ml-024", stem: "You are training a deep neural network and notice that the training error approaches zero, but the validation error is high and climbing. What immediate actions should you take?", level: "Apply", question_type: "mcq_multi", options: '["Implement Dropout layers.", "Add L2 regularisation (weight decay) to the optimizer.", "Increase the complexity of the network by adding more layers.", "Use data augmentation to artificially increase the size of the training set.", "Train the model for more epochs."]', correct_answers: '["Implement Dropout layers.", "Add L2 regularisation (weight decay) to the optimizer.", "Use data augmentation to artificially increase the size of the training set."]', explanation: "The network is overfitting. Dropout, weight decay, and data augmentation are valid mitigation strategies. Adding layers or training longer will make it worse.", difficulty: 1.9, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 70});

// Prereqs for Concept 3
MATCH (q17:Question {id: "q-ai-ml-017"}), (q20:Question {id: "q-ai-ml-020"}) CREATE (q17)-[:IS_PREREQUISITE_FOR]->(q20);
MATCH (q20:Question {id: "q-ai-ml-020"}), (q22:Question {id: "q-ai-ml-022"}) CREATE (q20)-[:IS_PREREQUISITE_FOR]->(q22);
MATCH (q22:Question {id: "q-ai-ml-022"}), (q24:Question {id: "q-ai-ml-024"}) CREATE (q22)-[:IS_PREREQUISITE_FOR]->(q24);

// --- c-ai-ml-004: Feature Engineering ---
// Repeat (q025-q027)
CREATE (q025:Question {id: "q-ai-ml-025", stem: "What is the primary goal of Feature Engineering?", level: "Repeat", question_type: "mcq_multi", options: '["To create new input features that make underlying patterns more obvious to the learning algorithm.", "To clean and transform raw data into a format suitable for machine learning models.", "To completely replace the need for machine learning algorithms.", "To improve model accuracy and interpretability.", "To randomly generate new data points."]', correct_answers: '["To create new input features that make underlying patterns more obvious to the learning algorithm.", "To clean and transform raw data into a format suitable for machine learning models.", "To improve model accuracy and interpretability."]', explanation: "Feature engineering transforms raw data into meaningful features that represent the underlying problem better, improving model performance.", difficulty: -1.2, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q026:Question {id: "q-ai-ml-026", stem: "Which of the following are common feature scaling techniques?", level: "Repeat", question_type: "mcq_multi", options: '["Min-Max Normalization", "Standardization (Z-score normalization)", "One-Hot Encoding", "Log Transformation", "Decision Trees"]', correct_answers: '["Min-Max Normalization", "Standardization (Z-score normalization)", "Log Transformation"]', explanation: "Min-Max, Z-score standardization, and log transformations are used to scale or normalize numerical features.", difficulty: -0.9, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q027:Question {id: "q-ai-ml-027", stem: "What is One-Hot Encoding used for?", level: "Repeat", question_type: "mcq_multi", options: '["Converting categorical variables into a binary matrix format.", "Allowing algorithms that expect numerical input to process categorical data.", "Preventing the algorithm from assuming an ordinal relationship between categorical labels.", "Scaling continuous variables.", "Removing outliers from the dataset."]', correct_answers: '["Converting categorical variables into a binary matrix format.", "Allowing algorithms that expect numerical input to process categorical data.", "Preventing the algorithm from assuming an ordinal relationship between categorical labels."]', explanation: "One-Hot Encoding converts categorical variables into binary vectors so numerical algorithms can process them without assuming false mathematical ordering.", difficulty: -0.7, discrimination: 1.2, guessing: 0.25, time_estimate_seconds: 45});

// Summary (q028-q029)
CREATE (q028:Question {id: "q-ai-ml-028", stem: "Why is Feature Selection important in the modeling pipeline?", level: "Summary", question_type: "mcq_multi", options: '["It reduces the dimensionality of the data, potentially decreasing training time.", "It helps mitigate the curse of dimensionality and reduces the risk of overfitting.", "It can improve model interpretability by removing irrelevant or redundant features.", "It increases the amount of data required to train the model.", "It ensures the model achieves 100% accuracy."]', correct_answers: '["It reduces the dimensionality of the data, potentially decreasing training time.", "It helps mitigate the curse of dimensionality and reduces the risk of overfitting.", "It can improve model interpretability by removing irrelevant or redundant features."]', explanation: "Feature selection removes redundant/irrelevant features, speeding up training, reducing overfitting, and aiding interpretability.", difficulty: 0.1, discrimination: 1.3, guessing: 0.25, time_estimate_seconds: 50});
CREATE (q029:Question {id: "q-ai-ml-029", stem: "How does handling missing data impact feature engineering?", level: "Summary", question_type: "mcq_multi", options: '["Imputing missing values with the mean can reduce the variance of the feature.", "Dropping rows with missing values can lead to a loss of valuable information and biased datasets.", "Using advanced imputation (like KNN) can capture complex relationships but is computationally expensive.", "Missing data should always be replaced with zero.", "Missing data is automatically handled perfectly by all ML algorithms."]', correct_answers: '["Imputing missing values with the mean can reduce the variance of the feature.", "Dropping rows with missing values can lead to a loss of valuable information and biased datasets.", "Using advanced imputation (like KNN) can capture complex relationships but is computationally expensive."]', explanation: "Missing data handling requires careful trade-offs. Mean imputation lowers variance, dropping data causes bias, and advanced methods cost compute.", difficulty: 0.4, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 55});

// Intuitive (q030)
CREATE (q030:Question {id: "q-ai-ml-030", stem: "Why must you fit your feature scaler (e.g., StandardScaler) ONLY on the training data, and then transform both train and test data?", level: "Intuitive", question_type: "mcq_multi", options: '["To prevent data leakage, where information from the test set influences the training process.", "Because the test set simulates unseen future data, and in production, you wouldn\\’t know the future mean/variance.", "Because scaling the test set separately would change the relative distances between train and test points.", "To save computational resources.", "Because the test set doesn\\’t need to be scaled."]', correct_answers: '["To prevent data leakage, where information from the test set influences the training process.", "Because the test set simulates unseen future data, and in production, you wouldn\\’t know the future mean/variance.", "Because scaling the test set separately would change the relative distances between train and test points."]', explanation: "Fitting scalers on the entire dataset leaks future knowledge (mean/variance of test data) into the model training, invalidating the evaluation.", difficulty: 1.3, discrimination: 1.6, guessing: 0.25, time_estimate_seconds: 60});

// Apply (q031-q032)
CREATE (q031:Question {id: "q-ai-ml-031", stem: "You have a feature 'DateTime' indicating when a transaction occurred. How would you engineer this for a model predicting retail sales?", level: "Apply", question_type: "mcq_multi", options: '["Extract categorical features like \'DayOfWeek\', \'Month\', and \'IsWeekend\'.", "Extract cyclical numerical features using sine and cosine transformations for time of day.", "Calculate the time elapsed since the previous transaction.", "Leave it as a raw Unix timestamp because regression models handle it perfectly.", "Convert the entire date string into a single One-Hot Encoded vector."]', correct_answers: '["Extract categorical features like \'DayOfWeek\', \'Month\', and \'IsWeekend\'.", "Extract cyclical numerical features using sine and cosine transformations for time of day.", "Calculate the time elapsed since the previous transaction."]', explanation: "Date/time data holds rich cyclical and categorical info. Raw timestamps or huge one-hot encodings are ineffective.", difficulty: 2.0, discrimination: 1.7, guessing: 0.25, time_estimate_seconds: 70});
CREATE (q032:Question {id: "q-ai-ml-032", stem: "A dataset contains a highly skewed numerical feature 'Income' with extreme right-tail outliers. Which transformations are appropriate before feeding it to a Linear Regression model?", level: "Apply", question_type: "mcq_multi", options: '["Apply a Log transformation to normalize the distribution.", "Apply a Box-Cox transformation to stabilize variance.", "Bin the income into ordinal categories (e.g., Low, Medium, High).", "Do nothing, linear regression is immune to outliers.", "Use One-Hot Encoding for every unique income value."]', correct_answers: '["Apply a Log transformation to normalize the distribution.", "Apply a Box-Cox transformation to stabilize variance.", "Bin the income into ordinal categories (e.g., Low, Medium, High)."]', explanation: "Skewed data hurts linear models. Log/Box-Cox transformations or binning help mitigate the impact of outliers and skewness.", difficulty: 2.2, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 70});

// Prereqs for Concept 4
MATCH (q25:Question {id: "q-ai-ml-025"}), (q28:Question {id: "q-ai-ml-028"}) CREATE (q25)-[:IS_PREREQUISITE_FOR]->(q28);
MATCH (q28:Question {id: "q-ai-ml-028"}), (q30:Question {id: "q-ai-ml-030"}) CREATE (q28)-[:IS_PREREQUISITE_FOR]->(q30);
