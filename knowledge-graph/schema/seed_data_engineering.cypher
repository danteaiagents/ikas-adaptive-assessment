// 3. Questions
// --- c-ai-de-001: Data Pipelines & ETL ---
// Repeat
CREATE (q001:Question {id: "q-ai-de-001", stem: "What does the acronym ETL stand for in data engineering?", level: "Repeat", question_type: "mcq_multi", options: '["Extract, Transform, Load", "Execute, Transfer, Log", "Enhance, Transform, Learn", "Extract, Translate, Load", "Export, Train, Load"]', correct_answers: '["Extract, Transform, Load"]', explanation: "ETL stands for Extract, Transform, Load, the standard process for moving data from source to destination.", difficulty: -1.2, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 30});
CREATE (q002:Question {id: "q-ai-de-002", stem: "Which of the following are standard phases in a data pipeline?", level: "Repeat", question_type: "mcq_multi", options: '["Data Ingestion", "Data Processing/Transformation", "Data Storage", "Hardware Manufacturing", "Model Inference"]', correct_answers: '["Data Ingestion", "Data Processing/Transformation", "Data Storage"]', explanation: "Pipelines ingest, process, and store data. Hardware manufacturing and model inference are not standard pipeline phases.", difficulty: -1.0, discrimination: 1.2, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q003:Question {id: "q-ai-de-003", stem: "What is ELT compared to ETL?", level: "Repeat", question_type: "mcq_multi", options: '["Load before Transform", "Transforming data in the data warehouse", "Extracting and Loading simultaneously", "A completely different methodology", "Faster data extraction"]', correct_answers: '["Load before Transform", "Transforming data in the data warehouse"]', explanation: "ELT loads raw data directly into the target system (warehouse/lake) and transforms it there using the target system compute.", difficulty: -0.8, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 45});

// Summary
CREATE (q004:Question {id: "q-ai-de-004", stem: "What is the primary advantage of using a workflow orchestrator like Apache Airflow?", level: "Summary", question_type: "mcq_multi", options: '["Managing dependency graphs of tasks", "Scheduling pipeline executions", "Monitoring failures and retries", "Training machine learning models", "Designing UI dashboards"]', correct_answers: '["Managing dependency graphs of tasks", "Scheduling pipeline executions", "Monitoring failures and retries"]', explanation: "Orchestrators like Airflow manage task dependencies (DAGs), scheduling, and monitoring. They do not train models or design UIs.", difficulty: 0.2, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 50});
CREATE (q005:Question {id: "q-ai-de-005", stem: "In a modern data architecture, what role does a data lake play in a pipeline?", level: "Summary", question_type: "mcq_multi", options: '["Storing raw, unstructured data", "Acting as a staging area before ETL", "Replacing relational databases entirely", "Providing real-time transactional processing", "Storing massive volumes of data cost-effectively"]', correct_answers: '["Storing raw, unstructured data", "Acting as a staging area before ETL", "Storing massive volumes of data cost-effectively"]', explanation: "Data lakes store large amounts of structured and unstructured data cost-effectively and often serve as the raw staging area.", difficulty: 0.4, discrimination: 1.3, guessing: 0.25, time_estimate_seconds: 55});

// Intuitive
CREATE (q006:Question {id: "q-ai-de-006", stem: "Why might a data team choose ELT over ETL for a massive analytical dataset?", level: "Intuitive", question_type: "mcq_multi", options: '["Modern cloud data warehouses have massive, scalable compute power for transformations.", "It avoids the bottleneck of a separate, dedicated transformation server.", "It allows analysts to access raw data immediately without waiting for complex transformations.", "It makes data ingestion slower.", "It eliminates the need to understand data schemas altogether."]', correct_answers: '["Modern cloud data warehouses have massive, scalable compute power for transformations.", "It avoids the bottleneck of a separate, dedicated transformation server.", "It allows analysts to access raw data immediately without waiting for complex transformations."]', explanation: "ELT leverages cloud warehouse compute, avoids standalone transformation server limits, and gets raw data into the system faster for exploration.", difficulty: 1.1, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q007:Question {id: "q-ai-de-007", stem: "What happens when an Airflow DAG task fails due to a transient API error, assuming retries are configured?", level: "Intuitive", question_type: "mcq_multi", options: '["The task will be re-executed according to the retry policy.", "Downstream tasks dependent on this task will be blocked.", "The entire DAG immediately fails and cannot be recovered.", "Airflow will automatically rewrite the code to fix the API error.", "The system will skip the task and execute downstream tasks anyway."]', correct_answers: '["The task will be re-executed according to the retry policy.", "Downstream tasks dependent on this task will be blocked."]', explanation: "Airflow will retry the task. While retrying or if it ultimately fails, dependent downstream tasks remain blocked.", difficulty: 1.3, discrimination: 1.6, guessing: 0.25, time_estimate_seconds: 65});

// Apply
CREATE (q008:Question {id: "q-ai-de-008", stem: "You are designing an ETL pipeline to move daily sales data into a warehouse. To ensure idempotency, how should your load step behave on a re-run?", level: "Apply", question_type: "mcq_multi", options: '["It should overwrite or upsert the data for that specific day.", "It should yield the exact same final state in the database as running it once.", "It should simply append the data again, duplicating records.", "It should randomly delete old data.", "It should ignore the date and load all historical data."]', correct_answers: '["It should overwrite or upsert the data for that specific day.", "It should yield the exact same final state in the database as running it once."]', explanation: "Idempotency means repeated executions produce the same result as a single execution. Using upserts or deleting/re-inserting the specific partition ensures this.", difficulty: 2.1, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 70});

// --- c-ai-de-002: Data Quality & Cleaning ---
// Repeat
CREATE (q009:Question {id: "q-ai-de-009", stem: "Which of the following are dimensions of data quality?", level: "Repeat", question_type: "mcq_multi", options: '["Accuracy", "Completeness", "Consistency", "Complexity", "Colorfulness"]', correct_answers: '["Accuracy", "Completeness", "Consistency"]', explanation: "Accuracy, completeness, and consistency are core data quality dimensions.", difficulty: -1.3, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 35});
CREATE (q010:Question {id: "q-ai-de-010", stem: "What is data imputation?", level: "Repeat", question_type: "mcq_multi", options: '["Filling in missing data values", "Deleting corrupt records", "Encrypting sensitive columns", "Transforming strings to integers", "Predicting future data points"]', correct_answers: '["Filling in missing data values"]', explanation: "Imputation is the process of replacing missing data with substituted values (e.g., mean, median).", difficulty: -1.1, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 40});

// Summary
CREATE (q011:Question {id: "q-ai-de-011", stem: "Why is data validation essential before training machine learning models?", level: "Summary", question_type: "mcq_multi", options: '["To prevent ’garbage in, garbage out’ scenarios.", "To ensure data conforms to expected schemas and statistical distributions.", "To automatically fix all logical errors in the business logic.", "To verify that no PII (Personally Identifiable Information) leaks into the training set.", "To speed up the model training process by compressing data."]', correct_answers: '["To prevent ’garbage in, garbage out’ scenarios.", "To ensure data conforms to expected schemas and statistical distributions.", "To verify that no PII (Personally Identifiable Information) leaks into the training set."]', explanation: "Data validation ensures quality, schema compliance, and safety (like PII checks) before training. It does not automatically fix business logic or compress data.", difficulty: 0.3, discrimination: 1.3, guessing: 0.25, time_estimate_seconds: 55});
CREATE (q012:Question {id: "q-ai-de-012", stem: "Which methods are commonly used to handle outliers in a dataset?", level: "Summary", question_type: "mcq_multi", options: '["Clipping or capping values at a specific percentile.", "Removing the rows containing the outliers.", "Applying a mathematical transformation (like log transform) to reduce skew.", "Randomly changing them to zero.", "Ignoring them completely in all scenarios."]', correct_answers: '["Clipping or capping values at a specific percentile.", "Removing the rows containing the outliers.", "Applying a mathematical transformation (like log transform) to reduce skew."]', explanation: "Outliers can be capped, removed, or mitigated via transformations like logarithms. Ignoring them or making them zero randomly is generally poor practice.", difficulty: 0.1, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 50});

// Intuitive
CREATE (q013:Question {id: "q-ai-de-013", stem: "If you observe a sudden drop in the average value of an ingested numerical column, what might be the cause?", level: "Intuitive", question_type: "mcq_multi", options: '["A change in the upstream system\\’s measurement units (e.g., from cm to meters).", "A bug introducing many zero or null values into the column.", "A true drift in the underlying business metrics or user behavior.", "A hardware failure in the data warehouse.", "The machine learning model overfitting."]', correct_answers: '["A change in the upstream system\\’s measurement units (e.g., from cm to meters).", "A bug introducing many zero or null values into the column.", "A true drift in the underlying business metrics or user behavior."]', explanation: "Sudden statistical shifts are often caused by upstream schema/unit changes, bugs introducing nulls/zeros, or true data drift. Hardware failures usually cause full ingestion failures, not value shifts.", difficulty: 1.4, discrimination: 1.7, guessing: 0.25, time_estimate_seconds: 65});
CREATE (q014:Question {id: "q-ai-de-014", stem: "Why might filling missing values with the mean of the column be a bad idea?", level: "Intuitive", question_type: "mcq_multi", options: '["It can artificially reduce the variance of the feature.", "It is highly sensitive to extreme outliers, skewing the imputed values.", "It destroys correlations between that column and other variables.", "It makes the dataset too small to train on.", "It requires a supercomputer to calculate."]', correct_answers: '["It can artificially reduce the variance of the feature.", "It is highly sensitive to extreme outliers, skewing the imputed values.", "It destroys correlations between that column and other variables."]', explanation: "Mean imputation reduces variance, is sensitive to outliers, and ignores relationships with other features, potentially weakening the model.", difficulty: 1.2, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 60});

// Apply
CREATE (q015:Question {id: "q-ai-de-015", stem: "You are setting up data quality checks for a pipeline that updates customer records. Which Great Expectations (or similar) rules would be appropriate?", level: "Apply", question_type: "mcq_multi", options: '["expect_column_values_to_not_be_null for the customer_id column.", "expect_column_values_to_be_unique for the customer_id column.", "expect_column_values_to_be_between for an age column (e.g., 0 to 120).", "expect_table_row_count_to_equal 10 exactly every day.", "expect_column_to_contain_only_integers for the customer email column."]', correct_answers: '["expect_column_values_to_not_be_null for the customer_id column.", "expect_column_values_to_be_unique for the customer_id column.", "expect_column_values_to_be_between for an age column (e.g., 0 to 120)."]', explanation: "IDs should be unique and non-null. Ages should fall within reasonable bounds. Row counts usually vary daily, and emails are strings, not integers.", difficulty: 2.0, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 70});
CREATE (q016:Question {id: "q-ai-de-016", stem: "A feature requires values to be strictly positive, but occasionally negative values appear due to sensor errors. How should an automated pipeline handle this safely?", level: "Apply", question_type: "mcq_multi", options: '["Route the anomalous rows to a dead-letter queue (DLQ) for manual inspection.", "Apply a transformation that replaces negative values with nulls, then use standard imputation.", "Alert the data engineering team if the anomaly rate exceeds a defined threshold.", "Automatically delete the entire database table and start over.", "Quietly convert negative values to positive by taking the absolute value without logging."]', correct_answers: '["Route the anomalous rows to a dead-letter queue (DLQ) for manual inspection.", "Apply a transformation that replaces negative values with nulls, then use standard imputation.", "Alert the data engineering team if the anomaly rate exceeds a defined threshold."]', explanation: "Safe handling involves routing bad data to a DLQ, applying controlled imputation, and alerting on high anomaly rates. Quietly changing values or deleting tables is destructive.", difficulty: 2.2, discrimination: 1.9, guessing: 0.25, time_estimate_seconds: 75});

// --- c-ai-de-003: Feature Stores ---
// Repeat
CREATE (q017:Question {id: "q-ai-de-017", stem: "What is the primary purpose of a Feature Store in MLOps?", level: "Repeat", question_type: "mcq_multi", options: '["To act as a centralized repository for curated machine learning features.", "To serve features for offline training and online inference.", "To facilitate feature reuse across different models and teams.", "To store the weights of trained neural networks.", "To write the machine learning algorithms."]', correct_answers: '["To act as a centralized repository for curated machine learning features.", "To serve features for offline training and online inference.", "To facilitate feature reuse across different models and teams."]', explanation: "Feature stores centralize, serve, and promote reuse of features. They do not store model weights (Model Registry does that) or write algorithms.", difficulty: -1.2, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q018:Question {id: "q-ai-de-018", stem: "What are the two primary components (or databases) typically found in a Feature Store architecture?", level: "Repeat", question_type: "mcq_multi", options: '["Offline Store for high-throughput batch training data.", "Online Store for low-latency, real-time inference.", "Model Registry for storing trained artifacts.", "Vector Index for similarity search.", "Code Repository for storing Python scripts."]', correct_answers: '["Offline Store for high-throughput batch training data.", "Online Store for low-latency, real-time inference."]', explanation: "Feature stores consist of an offline store (like a data warehouse) for batch training and an online store (like Redis) for low-latency inference.", difficulty: -0.9, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 45});

// Summary
CREATE (q019:Question {id: "q-ai-de-019", stem: "How does a Feature Store solve the 'training-serving skew' problem?", level: "Summary", question_type: "mcq_multi", options: '["By ensuring the exact same transformation code is used to generate features for both training and inference.", "By providing a unified API that guarantees consistency between the offline and online stores.", "By performing point-in-time correct joins to prevent data leakage during training.", "By automatically retraining models every hour.", "By making the online store as slow as the offline store."]', correct_answers: '["By ensuring the exact same transformation code is used to generate features for both training and inference.", "By providing a unified API that guarantees consistency between the offline and online stores.", "By performing point-in-time correct joins to prevent data leakage during training."]', explanation: "Feature stores ensure consistent transformations, provide unified APIs, and handle point-in-time correctness, thereby eliminating the inconsistencies that cause skew. They do not auto-retrain models.", difficulty: 0.4, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q020:Question {id: "q-ai-de-020", stem: "What does 'Point-in-Time Correctness' (or time-travel) mean in the context of generating training data?", level: "Summary", question_type: "mcq_multi", options: '["Joining feature values exactly as they existed at the moment the historical event occurred.", "Preventing future data (data leakage) from being used to predict past events.", "Ensuring the training dataset reflects the state of the world at the prediction time.", "Using a time machine to gather more data.", "Converting all timestamps to UTC."]', correct_answers: '["Joining feature values exactly as they existed at the moment the historical event occurred.", "Preventing future data (data leakage) from being used to predict past events.", "Ensuring the training dataset reflects the state of the world at the prediction time."]', explanation: "Point-in-time correctness ensures you join historical labels with the exact feature values available at that past timestamp, preventing data leakage.", difficulty: 0.5, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 55});

// Intuitive
CREATE (q021:Question {id: "q-ai-de-021", stem: "Why is an Online Store in a Feature Store typically backed by an in-memory database like Redis?", level: "Intuitive", question_type: "mcq_multi", options: '["Because real-time inference requires extremely low-latency (millisecond) reads.", "Because it only needs to store the most recent feature values for each entity.", "Because Redis provides complex analytical join capabilities.", "Because in-memory databases are cheaper for petabyte-scale storage.", "Because it requires high-throughput batch writes."]', correct_answers: '["Because real-time inference requires extremely low-latency (millisecond) reads.", "Because it only needs to store the most recent feature values for each entity."]', explanation: "Online stores serve individual feature vectors to real-time models in milliseconds, holding only the latest values. Redis excels at this. They do not handle complex joins or massive batch storage.", difficulty: 1.2, discrimination: 1.6, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q022:Question {id: "q-ai-de-022", stem: "If a data scientist modifies a feature definition in the Feature Store, what impact does it have?", level: "Intuitive", question_type: "mcq_multi", options: '["The change will automatically propagate to both training and serving pipelines, ensuring consistency.", "Existing models relying on the old definition might break or require retraining if the change is not versioned.", "It enables other teams to discover and use the newly improved feature.", "It deletes all historical data in the offline store.", "It instantly updates all currently deployed models without retraining."]', correct_answers: '["The change will automatically propagate to both training and serving pipelines, ensuring consistency.", "Existing models relying on the old definition might break or require retraining if the change is not versioned.", "It enables other teams to discover and use the newly improved feature."]', explanation: "Changes propagate consistently, promoting reuse, but unversioned changes can break existing models. Modifying a feature doesn\'t auto-update deployed models or delete history.", difficulty: 1.5, discrimination: 1.7, guessing: 0.25, time_estimate_seconds: 65});

// Apply
CREATE (q023:Question {id: "q-ai-de-023", stem: "You are building a real-time fraud detection system. Which architecture correctly utilizes a Feature Store?", level: "Apply", question_type: "mcq_multi", options: '["The streaming pipeline calculates 5-minute transaction aggregates and writes them to the Online Store.", "The model service queries the Online Store using the user_id to fetch the latest aggregates in milliseconds.", "The offline store periodically syncs with the online store to maintain a historical log for future training.", "The model service queries a massive Snowflake cluster for real-time inference.", "The model calculates all historical aggregates on-the-fly during the inference request."]', correct_answers: '["The streaming pipeline calculates 5-minute transaction aggregates and writes them to the Online Store.", "The model service queries the Online Store using the user_id to fetch the latest aggregates in milliseconds.", "The offline store periodically syncs with the online store to maintain a historical log for future training."]', explanation: "Streaming updates the online store for fast lookup. The offline store logs history. Querying Snowflake or calculating on-the-fly during inference is too slow for real-time fraud detection.", difficulty: 2.2, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 70});
CREATE (q024:Question {id: "q-ai-de-024", stem: "When backfilling a new feature (e.g., 'user lifetime value') into a Feature Store, what is the critical requirement?", level: "Apply", question_type: "mcq_multi", options: '["The backfill must compute the feature value as it would have been at each historical point in time.", "The backfill must avoid using data that was generated after the historical timestamp.", "The backfill job must be executed on the Online Store.", "The backfill must overwrite all existing features.", "The backfill should only compute the value for the current day."]', correct_answers: '["The backfill must compute the feature value as it would have been at each historical point in time.", "The backfill must avoid using data that was generated after the historical timestamp."]', explanation: "Backfilling requires strict point-in-time correctness to prevent data leakage. It runs on the offline store, not the online store.", difficulty: 2.3, discrimination: 1.9, guessing: 0.25, time_estimate_seconds: 70});

// --- c-ai-de-004: Data Versioning & Lineage ---
// Repeat
CREATE (q025:Question {id: "q-ai-de-025", stem: "What is Data Versioning?", level: "Repeat", question_type: "mcq_multi", options: '["Treating data and datasets similarly to how Git treats code.", "Keeping historical snapshots of data to ensure reproducibility.", "Tracking exactly which dataset version was used to train a specific model.", "Automatically deleting old data to save space.", "Upgrading the database software version."]', correct_answers: '["Treating data and datasets similarly to how Git treats code.", "Keeping historical snapshots of data to ensure reproducibility.", "Tracking exactly which dataset version was used to train a specific model."]', explanation: "Data versioning tracks changes to datasets over time, enabling reproducibility and lineage tracking.", difficulty: -1.3, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q026:Question {id: "q-ai-de-026", stem: "What does Data Lineage describe?", level: "Repeat", question_type: "mcq_multi", options: '["The lifecycle of data, including its origins, transformations, and movements.", "A map showing how data flows from source systems to final ML models.", "The hierarchical dependencies between different data tables.", "The speed at which data travels over the network.", "The hardware used to process the data."]', correct_answers: '["The lifecycle of data, including its origins, transformations, and movements.", "A map showing how data flows from source systems to final ML models.", "The hierarchical dependencies between different data tables."]', explanation: "Lineage is the map of data flow, origins, and dependencies. It does not measure network speed or hardware specifics.", difficulty: -1.1, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 40});

// Summary
CREATE (q027:Question {id: "q-ai-de-027", stem: "Why are tools like DVC (Data Version Control) necessary in an MLOps stack?", level: "Summary", question_type: "mcq_multi", options: '["Standard Git cannot efficiently handle massive binary files or gigabyte-scale datasets.", "They link code versions (in Git) to specific data versions stored in cloud storage (S3, GCS).", "They allow teams to revert to previous datasets if a new data pipeline introduces errors.", "They completely replace the need for Git.", "They automatically write SQL queries for the data."]', correct_answers: '["Standard Git cannot efficiently handle massive binary files or gigabyte-scale datasets.", "They link code versions (in Git) to specific data versions stored in cloud storage (S3, GCS).", "They allow teams to revert to previous datasets if a new data pipeline introduces errors."]', explanation: "DVC extends Git-like tracking to large files by storing pointers in Git and data in cloud storage. It works alongside Git, not replacing it.", difficulty: 0.2, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 55});
CREATE (q028:Question {id: "q-ai-de-028", stem: "How does comprehensive data lineage aid in debugging a poorly performing machine learning model?", level: "Summary", question_type: "mcq_multi", options: '["It allows engineers to trace a bad feature back to the specific upstream table or ETL job that generated it.", "It helps identify if an upstream schema change silently corrupted the input data.", "It shows exactly which downstream consumers will be affected if a model is taken offline.", "It automatically corrects the weights of the neural network.", "It prevents the model from making incorrect predictions."]', correct_answers: '["It allows engineers to trace a bad feature back to the specific upstream table or ETL job that generated it.", "It helps identify if an upstream schema change silently corrupted the input data.", "It shows exactly which downstream consumers will be affected if a model is taken offline."]', explanation: "Lineage provides observability across the pipeline for debugging root causes and assessing impact. It cannot auto-correct weights or prevent bad predictions.", difficulty: 0.4, discrimination: 1.3, guessing: 0.25, time_estimate_seconds: 60});

// Intuitive
CREATE (q029:Question {id: "q-ai-de-029", stem: "In data versioning, why is simply adding a timestamp to a filename (e.g., dataset_20231012.csv) considered an anti-pattern for large teams?", level: "Intuitive", question_type: "mcq_multi", options: '["It lacks cryptographic hashing to guarantee data integrity.", "It does not tightly couple the data version with the corresponding code version.", "It creates a massive sprawl of duplicated files without differential storage optimization.", "Timestamps are mathematically impossible to sort.", "CSV files cannot be versioned."]', correct_answers: '["It lacks cryptographic hashing to guarantee data integrity.", "It does not tightly couple the data version with the corresponding code version.", "It creates a massive sprawl of duplicated files without differential storage optimization."]', explanation: "Timestamping lacks integrity guarantees (hashes), code-coupling, and storage efficiency. Timestamps sort easily, and CSVs can be versioned, but timestamping is just a poor methodology.", difficulty: 1.4, discrimination: 1.6, guessing: 0.25, time_estimate_seconds: 65});
CREATE (q030:Question {id: "q-ai-de-030", stem: "How do modern cloud data warehouses like Snowflake natively provide a form of data versioning?", level: "Intuitive", question_type: "mcq_multi", options: '["Through \'Time Travel\' features that allow querying the database as it existed at a past point in time.", "By retaining immutable snapshots of micro-partitions when data is updated or deleted.", "By integrating directly with DVC and Git under the hood.", "By backing up the entire database to a tape drive every hour.", "By preventing users from ever deleting data."]', correct_answers: '["Through \'Time Travel\' features that allow querying the database as it existed at a past point in time.", "By retaining immutable snapshots of micro-partitions when data is updated or deleted."]', explanation: "Snowflake\\'s Time Travel relies on keeping historical immutable micro-partitions for a set period, allowing point-in-time queries without external tools like DVC.", difficulty: 1.6, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 60});

// Apply
CREATE (q031:Question {id: "q-ai-de-031", stem: "You must implement strict reproducibility for a regulated financial ML model. Which workflow ensures this?", level: "Apply", question_type: "mcq_multi", options: '["Commit the data processing script to Git and the resulting dataset hash to DVC.", "Tag the Git commit with the model version, creating a linked snapshot of code, data, and hyperparameters.", "Store the trained model artifact in a registry linked to the Git commit hash.", "Just save the Jupyter notebook and the CSV file in a shared Google Drive.", "Delete the training data after training to save storage costs."]', correct_answers: '["Commit the data processing script to Git and the resulting dataset hash to DVC.", "Tag the Git commit with the model version, creating a linked snapshot of code, data, and hyperparameters.", "Store the trained model artifact in a registry linked to the Git commit hash."]', explanation: "Reproducibility requires linking the code (Git), data (DVC hash), and model artifact (Registry). Shared drives and deleting data break reproducibility.", difficulty: 2.1, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 70});
CREATE (q032:Question {id: "q-ai-de-032", stem: "A downstream ML model is suddenly failing. Lineage shows the upstream 'users' table is the source. How do you investigate using versioning and lineage tools?", level: "Apply", question_type: "mcq_multi", options: '["Compare the data schemas of the current \'users\' table against the version from yesterday.", "Check the Git history of the ETL pipeline that populates the \'users\' table for recent merged PRs.", "Trace the lineage graph to see if the system feeding the \'users\' table had any upstream anomalies.", "Immediately retrain the model on the broken data to help it adapt.", "Restart the Airflow scheduler."]', correct_answers: '["Compare the data schemas of the current \'users\' table against the version from yesterday.", "Check the Git history of the ETL pipeline that populates the \'users\' table for recent merged PRs.", "Trace the lineage graph to see if the system feeding the \'users\' table had any upstream anomalies."]', explanation: "Investigation involves checking schema versions, ETL code changes, and upstream data sources. Retraining on broken data or restarting Airflow won\\'t fix root causes.", difficulty: 2.0, discrimination: 1.7, guessing: 0.25, time_estimate_seconds: 70});

// --- c-ai-de-005: Batch vs Stream Processing ---
// Repeat
CREATE (q033:Question {id: "q-ai-de-033", stem: "What is a defining characteristic of Batch Processing?", level: "Repeat", question_type: "mcq_multi", options: '["Processing large volumes of data all at once at scheduled intervals.", "High latency between data generation and data processing.", "Processing data continuously in near real-time.", "Operating on bounded datasets (data with a known start and end).", "Responding to user clicks within milliseconds."]', correct_answers: '["Processing large volumes of data all at once at scheduled intervals.", "High latency between data generation and data processing.", "Operating on bounded datasets (data with a known start and end)."]', explanation: "Batch processes bounded data at intervals, resulting in high latency. Streaming handles continuous, real-time data.", difficulty: -1.2, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q034:Question {id: "q-ai-de-034", stem: "What is a defining characteristic of Stream Processing?", level: "Repeat", question_type: "mcq_multi", options: '["Processing data continuously as it arrives.", "Low latency, near real-time processing.", "Operating on unbounded datasets (infinite streams of data).", "Running only once per day at midnight.", "Always requiring a relational database to function."]', correct_answers: '["Processing data continuously as it arrives.", "Low latency, near real-time processing.", "Operating on unbounded datasets (infinite streams of data)."]', explanation: "Stream processing handles infinite, unbounded data continuously with low latency.", difficulty: -1.1, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q035:Question {id: "q-ai-de-035", stem: "Which technologies are primarily associated with Stream Processing?", level: "Repeat", question_type: "mcq_multi", options: '["Apache Kafka", "Apache Flink", "Hadoop MapReduce", "Cron jobs", "Apache Spark Structured Streaming"]', correct_answers: '["Apache Kafka", "Apache Flink", "Apache Spark Structured Streaming"]', explanation: "Kafka, Flink, and Spark Streaming are streaming technologies. MapReduce and Cron are for batch processing.", difficulty: -0.9, discrimination: 1.2, guessing: 0.25, time_estimate_seconds: 35});

// Summary
CREATE (q036:Question {id: "q-ai-de-036", stem: "What is the Lambda Architecture in data engineering?", level: "Summary", question_type: "mcq_multi", options: '["A system that runs both a batch layer and a speed (stream) layer simultaneously.", "It uses the batch layer for comprehensive, accurate historical views.", "It uses the speed layer to provide low-latency, approximate views of recent data.", "A cloud computing service like AWS Lambda.", "An architecture that completely eliminates batch processing."]', correct_answers: '["A system that runs both a batch layer and a speed (stream) layer simultaneously.", "It uses the batch layer for comprehensive, accurate historical views.", "It uses the speed layer to provide low-latency, approximate views of recent data."]', explanation: "Lambda architecture combines a robust batch layer with a fast streaming layer to balance accuracy and latency.", difficulty: 0.3, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q037:Question {id: "q-ai-de-037", stem: "How does the Kappa Architecture differ from the Lambda Architecture?", level: "Summary", question_type: "mcq_multi", options: '["Kappa architecture eliminates the separate batch layer entirely.", "Kappa treats everything as a stream, processing historical data simply by replaying the stream.", "Kappa requires maintaining two separate codebases.", "Kappa is significantly simpler to manage because it uses a single unified processing framework.", "Kappa cannot process historical data."]', correct_answers: '["Kappa architecture eliminates the separate batch layer entirely.", "Kappa treats everything as a stream, processing historical data simply by replaying the stream.", "Kappa is significantly simpler to manage because it uses a single unified processing framework."]', explanation: "Kappa simplifies the pipeline by treating all data (real-time and historical) as streams, eliminating the need to maintain separate batch logic.", difficulty: 0.5, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 60});

// Intuitive
CREATE (q038:Question {id: "q-ai-de-038", stem: "In stream processing, what is the difference between 'Event Time' and 'Processing Time'?", level: "Intuitive", question_type: "mcq_multi", options: '["Event Time is when the event actually occurred in the real world.", "Processing Time is when the streaming system receives and processes the event.", "They are exactly the same in distributed systems.", "Processing Time is always earlier than Event Time.", "Significant delays between Event Time and Processing Time indicate network lag or system backlog."]', correct_answers: '["Event Time is when the event actually occurred in the real world.", "Processing Time is when the streaming system receives and processes the event.", "Significant delays between Event Time and Processing Time indicate network lag or system backlog."]', explanation: "Event time is the timestamp on the data. Processing time is when the server handles it. Delays cause them to diverge.", difficulty: 1.3, discrimination: 1.6, guessing: 0.25, time_estimate_seconds: 65});
CREATE (q039:Question {id: "q-ai-de-039", stem: "Why is handling 'late data' difficult in stream processing?", level: "Intuitive", question_type: "mcq_multi", options: '["Because the system may have already closed the time window and emitted the final result.", "Because it requires maintaining state in memory longer to wait for delayed events.", "Because watermarks must be carefully configured to balance latency and accuracy.", "Because late data is mathematically impossible in Kafka.", "Because it forces the system to reboot."]', correct_answers: '["Because the system may have already closed the time window and emitted the final result.", "Because it requires maintaining state in memory longer to wait for delayed events.", "Because watermarks must be carefully configured to balance latency and accuracy."]', explanation: "Late arriving data forces streaming systems to hold state longer and use watermarks to decide when to finally close a window.", difficulty: 1.5, discrimination: 1.7, guessing: 0.25, time_estimate_seconds: 65});

// Apply
CREATE (q040:Question {id: "q-ai-de-040", stem: "You need to aggregate website clicks over a 5-minute period, but mobile clients often lose signal and send data 10 minutes late. How do you configure the streaming job?", level: "Apply", question_type: "mcq_multi", options: '["Use Tumbling Windows based on Event Time.", "Configure a Watermark with a tolerance of at least 10 minutes to wait for late data.", "Configure the system to emit updates when late data arrives, rather than just dropping it.", "Use Processing Time windows so the data is counted whenever it arrives.", "Disable windows entirely and use a batch job instead."]', correct_answers: '["Use Tumbling Windows based on Event Time.", "Configure a Watermark with a tolerance of at least 10 minutes to wait for late data.", "Configure the system to emit updates when late data arrives, rather than just dropping it."]', explanation: "To handle late mobile data correctly, you must use Event Time windows, set a generous watermark, and allow late firings to update the aggregate.", difficulty: 2.1, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 70});
CREATE (q041:Question {id: "q-ai-de-041", stem: "A recommendation engine needs user embeddings updated nightly, and current session clicks updated instantly. Which architecture fits best?", level: "Apply", question_type: "mcq_multi", options: '["A Lambda Architecture.", "A nightly Airflow batch job for the deep user embeddings.", "A Kafka/Flink stream for the real-time session context.", "A pure Hadoop MapReduce pipeline running every minute.", "A single SQLite database."]', correct_answers: '["A Lambda Architecture.", "A nightly Airflow batch job for the deep user embeddings.", "A Kafka/Flink stream for the real-time session context."]', explanation: "This classic dual-requirement is solved by Lambda Architecture: batch (Airflow) for heavy nightly embeddings, and stream (Kafka/Flink) for real-time clicks.", difficulty: 2.0, discrimination: 1.7, guessing: 0.25, time_estimate_seconds: 70});

// --- c-ai-de-006: Vector Databases & Embeddings ---
// Repeat
CREATE (q042:Question {id: "q-ai-de-042", stem: "What is a mathematical embedding in the context of AI?", level: "Repeat", question_type: "mcq_multi", options: '["A dense array (vector) of floating-point numbers representing the semantic meaning of data.", "A way to convert text, images, or audio into a format neural networks can process.", "A point in a high-dimensional mathematical space.", "A compressed zip file of an image.", "A relational table row."]', correct_answers: '["A dense array (vector) of floating-point numbers representing the semantic meaning of data.", "A way to convert text, images, or audio into a format neural networks can process.", "A point in a high-dimensional mathematical space."]', explanation: "Embeddings map data into dense, high-dimensional continuous vector spaces representing semantic meaning.", difficulty: -1.3, discrimination: 1.0, guessing: 0.25, time_estimate_seconds: 40});
CREATE (q043:Question {id: "q-ai-de-043", stem: "Which of the following are specialized Vector Databases?", level: "Repeat", question_type: "mcq_multi", options: '["Pinecone", "Milvus", "Qdrant", "PostgreSQL", "MongoDB"]', correct_answers: '["Pinecone", "Milvus", "Qdrant"]', explanation: "Pinecone, Milvus, and Qdrant are purpose-built vector databases. While Postgres and Mongo have vector extensions, they are not primarily specialized vector DBs.", difficulty: -1.0, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 35});
CREATE (q044:Question {id: "q-ai-de-044", stem: "What metric is most commonly used to determine the similarity between two embeddings?", level: "Repeat", question_type: "mcq_multi", options: '["Cosine Similarity", "Euclidean Distance (L2)", "Dot Product", "Levenshtein Distance", "Jaccard Index"]', correct_answers: '["Cosine Similarity", "Euclidean Distance (L2)", "Dot Product"]', explanation: "Cosine similarity, L2 distance, and dot product are the standard metrics for vector similarity search.", difficulty: -0.9, discrimination: 1.1, guessing: 0.25, time_estimate_seconds: 40});

// Summary
CREATE (q045:Question {id: "q-ai-de-045", stem: "Why do we need specialized Vector Databases instead of just using standard relational databases for embeddings?", level: "Summary", question_type: "mcq_multi", options: '["Standard exact-match indexing (like B-Trees) cannot efficiently search high-dimensional vector spaces.", "Vector databases implement Approximate Nearest Neighbor (ANN) algorithms for massive scalability.", "Vector databases are optimized for performing millions of complex floating-point distance calculations per second.", "Vector databases can store images directly as JPEGs.", "Standard databases cannot store arrays of floats."]', correct_answers: '["Standard exact-match indexing (like B-Trees) cannot efficiently search high-dimensional vector spaces.", "Vector databases implement Approximate Nearest Neighbor (ANN) algorithms for massive scalability.", "Vector databases are optimized for performing millions of complex floating-point distance calculations per second."]', explanation: "B-Trees fail in high dimensions. Vector DBs use ANN algorithms (like HNSW) to scale similarity searches. Relational DBs can store float arrays, but searching them without ANN is extremely slow.", difficulty: 0.4, discrimination: 1.4, guessing: 0.25, time_estimate_seconds: 60});
CREATE (q046:Question {id: "q-ai-de-046", stem: "What is HNSW (Hierarchical Navigable Small World)?", level: "Summary", question_type: "mcq_multi", options: '["A highly popular algorithm used for Approximate Nearest Neighbor (ANN) search.", "A multi-layered graph architecture where connections are formed based on distance.", "An algorithm that balances search speed, index build time, and memory usage effectively.", "A type of recurrent neural network.", "A relational database schema design."]', correct_answers: '["A highly popular algorithm used for Approximate Nearest Neighbor (ANN) search.", "A multi-layered graph architecture where connections are formed based on distance.", "An algorithm that balances search speed, index build time, and memory usage effectively."]', explanation: "HNSW is the leading ANN graph algorithm used in most modern vector databases.", difficulty: 0.5, discrimination: 1.5, guessing: 0.25, time_estimate_seconds: 55});

// Intuitive
CREATE (q047:Question {id: "q-ai-de-047", stem: "In a vector search, what is the trade-off inherent in 'Approximate' Nearest Neighbor (ANN) search?", level: "Intuitive", question_type: "mcq_multi", options: '["You trade a small amount of accuracy (recall) for massive gains in search speed.", "You trade storage space for faster exact matches.", "You might not always get the absolute mathematically closest vectors in the entire dataset.", "The algorithm uses significantly less memory than exact search (KNN).", "You trade network latency for compute costs."]', correct_answers: '["You trade a small amount of accuracy (recall) for massive gains in search speed.", "You might not always get the absolute mathematically closest vectors in the entire dataset.", "The algorithm uses significantly less memory than exact search (KNN)."]', explanation: "ANN sacrifices perfect recall (guaranteeing the absolute closest vector) to achieve sub-millisecond search times over millions of records. Wait, ANN often uses MORE memory (for the graph index) than brute force, so let me adjust correct options.", difficulty: 1.6, discrimination: 1.6, guessing: 0.25, time_estimate_seconds: 65});
// Adjust q047 options
MATCH (q:Question {id: "q-ai-de-047"}) SET q.options = '["You trade a small amount of accuracy (recall) for massive gains in search speed.", "You might not always get the absolute mathematically closest vectors in the entire dataset.", "The algorithm often requires maintaining complex indexes (like graphs) in RAM, increasing memory usage.", "The algorithm uses significantly less memory than exact search (KNN).", "You trade network latency for compute costs."]', q.correct_answers = '["You trade a small amount of accuracy (recall) for massive gains in search speed.", "You might not always get the absolute mathematically closest vectors in the entire dataset.", "The algorithm often requires maintaining complex indexes (like graphs) in RAM, increasing memory usage."]';

CREATE (q048:Question {id: "q-ai-de-048", stem: "Why does embedding high-dimensionality (e.g., 1536 dimensions) make search computationally difficult?", level: "Intuitive", question_type: "mcq_multi", options: '["The \'Curse of Dimensionality\' makes distances between all points seem almost equal.", "Calculating the distance between two 1536-dim vectors requires thousands of floating point operations.", "Memory bandwidth becomes a bottleneck when scanning large numbers of dense vectors.", "It becomes impossible to use Python to process them.", "High dimensions cause integer overflow."]', correct_answers: '["The \'Curse of Dimensionality\' makes distances between all points seem almost equal.", "Calculating the distance between two 1536-dim vectors requires thousands of floating point operations.", "Memory bandwidth becomes a bottleneck when scanning large numbers of dense vectors."]', explanation: "The curse of dimensionality reduces distance contrast, compute scales linearly with dimensions, and memory bandwidth is exhausted quickly.", difficulty: 1.4, discrimination: 1.7, guessing: 0.25, time_estimate_seconds: 60});

// Apply
CREATE (q049:Question {id: "q-ai-de-049", stem: "You are building a RAG system and notice that document chunks about 'Apple' (fruit) are being retrieved for queries about 'Apple' (company). How do you solve this at the data engineering layer?", level: "Apply", question_type: "mcq_multi", options: '["Use a more advanced embedding model that captures contextual semantic meaning better.", "Implement metadata filtering (e.g., category=\'technology\') in the vector database query.", "Store the embeddings in a relational database instead.", "Increase the temperature of the LLM.", "Append the string \'company\' to all documents before embedding."]', correct_answers: '["Use a more advanced embedding model that captures contextual semantic meaning better.", "Implement metadata filtering (e.g., category=\'technology\') in the vector database query."]', explanation: "Better embedding models separate contexts naturally. Alternatively, adding hard metadata filters (like tags) directly to the vector DB search ensures precision.", difficulty: 2.1, discrimination: 1.8, guessing: 0.25, time_estimate_seconds: 70});
CREATE (q050:Question {id: "q-ai-de-050", stem: "Your vector database has grown to 1 billion embeddings and memory costs are too high. Which engineering techniques reduce costs while maintaining search ability?", level: "Apply", question_type: "mcq_multi", options: '["Product Quantization (PQ) to compress the vectors.", "Scalar Quantization to reduce float32 vectors to int8.", "Moving the index entirely to disk and accepting higher latency.", "Deleting 90% of the data randomly.", "Converting the vectors to JSON strings."]', correct_answers: '["Product Quantization (PQ) to compress the vectors.", "Scalar Quantization to reduce float32 vectors to int8.", "Moving the index entirely to disk and accepting higher latency."]', explanation: "Quantization (PQ, scalar) compresses vectors in memory. Modern DBs also support disk-ann (putting graphs on fast NVMe) to save RAM at the cost of some latency.", difficulty: 2.3, discrimination: 1.9, guessing: 0.25, time_estimate_seconds: 75});


// 4. Create relationships to Concepts
MATCH (c:Concept {id: "c-ai-de-001"}), (q:Question) WHERE q.id IN ["q-ai-de-001","q-ai-de-002","q-ai-de-003","q-ai-de-004","q-ai-de-005","q-ai-de-006","q-ai-de-007","q-ai-de-008"] CREATE (c)-[:CONTAINS]->(q);
MATCH (c:Concept {id: "c-ai-de-002"}), (q:Question) WHERE q.id IN ["q-ai-de-009","q-ai-de-010","q-ai-de-011","q-ai-de-012","q-ai-de-013","q-ai-de-014","q-ai-de-015","q-ai-de-016"] CREATE (c)-[:CONTAINS]->(q);
MATCH (c:Concept {id: "c-ai-de-003"}), (q:Question) WHERE q.id IN ["q-ai-de-017","q-ai-de-018","q-ai-de-019","q-ai-de-020","q-ai-de-021","q-ai-de-022","q-ai-de-023","q-ai-de-024"] CREATE (c)-[:CONTAINS]->(q);
MATCH (c:Concept {id: "c-ai-de-004"}), (q:Question) WHERE q.id IN ["q-ai-de-025","q-ai-de-026","q-ai-de-027","q-ai-de-028","q-ai-de-029","q-ai-de-030","q-ai-de-031","q-ai-de-032"] CREATE (c)-[:CONTAINS]->(q);
MATCH (c:Concept {id: "c-ai-de-005"}), (q:Question) WHERE q.id IN ["q-ai-de-033","q-ai-de-034","q-ai-de-035","q-ai-de-036","q-ai-de-037","q-ai-de-038","q-ai-de-039","q-ai-de-040","q-ai-de-041"] CREATE (c)-[:CONTAINS]->(q);
MATCH (c:Concept {id: "c-ai-de-006"}), (q:Question) WHERE q.id IN ["q-ai-de-042","q-ai-de-043","q-ai-de-044","q-ai-de-045","q-ai-de-046","q-ai-de-047","q-ai-de-048","q-ai-de-049","q-ai-de-050"] CREATE (c)-[:CONTAINS]->(q);

// Establish Prerequisites between difficulty levels within each concept
MATCH (q1:Question {level: "Repeat"}), (q2:Question {level: "Summary"})
WITH q1, q2
MATCH (c:Concept)-[:CONTAINS]->(q1), (c)-[:CONTAINS]->(q2)
MERGE (q1)-[:IS_PREREQUISITE_FOR {p_pass_given_pass: 0.8, p_pass_given_fail: 0.2}]->(q2);

MATCH (q2:Question {level: "Summary"}), (q3:Question {level: "Intuitive"})
WITH q2, q3
MATCH (c:Concept)-[:CONTAINS]->(q2), (c)-[:CONTAINS]->(q3)
MERGE (q2)-[:IS_PREREQUISITE_FOR {p_pass_given_pass: 0.75, p_pass_given_fail: 0.15}]->(q3);

MATCH (q3:Question {level: "Intuitive"}), (q4:Question {level: "Apply"})
WITH q3, q4
MATCH (c:Concept)-[:CONTAINS]->(q3), (c)-[:CONTAINS]->(q4)
MERGE (q3)-[:IS_PREREQUISITE_FOR {p_pass_given_pass: 0.7, p_pass_given_fail: 0.1}]->(q4);

// Cross-concept prerequisites
MATCH (c1:Concept {id: "c-ai-de-001"}), (c2:Concept {id: "c-ai-de-002"})
MERGE (c1)-[:IS_PREREQUISITE_FOR {p_pass_given_pass: 0.8, p_pass_given_fail: 0.2}]->(c2);
MATCH (c1:Concept {id: "c-ai-de-001"}), (c3:Concept {id: "c-ai-de-003"})
MERGE (c1)-[:IS_PREREQUISITE_FOR {p_pass_given_pass: 0.8, p_pass_given_fail: 0.2}]->(c3);
MATCH (c3:Concept {id: "c-ai-de-003"}), (c4:Concept {id: "c-ai-de-004"})
MERGE (c3)-[:IS_PREREQUISITE_FOR {p_pass_given_pass: 0.75, p_pass_given_fail: 0.15}]->(c4);
MATCH (c1:Concept {id: "c-ai-de-001"}), (c5:Concept {id: "c-ai-de-005"})
MERGE (c1)-[:IS_PREREQUISITE_FOR {p_pass_given_pass: 0.7, p_pass_given_fail: 0.2}]->(c5);
MATCH (c1:Concept {id: "c-ai-de-001"}), (c6:Concept {id: "c-ai-de-006"})
MERGE (c1)-[:IS_PREREQUISITE_FOR {p_pass_given_pass: 0.75, p_pass_given_fail: 0.15}]->(c6);

