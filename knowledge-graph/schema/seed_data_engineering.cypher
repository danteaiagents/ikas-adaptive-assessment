// 1. Topic and Concepts
MATCH (s:Subject {id: "s-ai"})
CREATE (t:Topic {id: "t-ai-data-engineering", name: "Data Engineering for AI"})
CREATE (s)-[:CONTAINS]->(t);

CREATE (c1:Concept {id: "c-ai-de-001", name: "Data Pipelines & ETL", description: "Extract, Transform, Load processes and orchestrating data movement."});
CREATE (c2:Concept {id: "c-ai-de-002", name: "Data Quality & Cleaning", description: "Ensuring data accuracy, completeness, and reliability for AI models."});
CREATE (c3:Concept {id: "c-ai-de-003", name: "Feature Stores", description: "Centralized repositories for storing, managing, and serving machine learning features."});
CREATE (c4:Concept {id: "c-ai-de-004", name: "Data Versioning & Lineage", description: "Tracking changes to datasets and understanding data origins."});
CREATE (c5:Concept {id: "c-ai-de-005", name: "Batch vs Stream Processing", description: "Paradigms for processing data at rest versus data in motion."});
CREATE (c6:Concept {id: "c-ai-de-006", name: "Vector Databases & Embeddings", description: "Storage and retrieval systems optimized for high-dimensional vector data."});

MATCH (t:Topic {id: "t-ai-data-engineering"}), (c:Concept) WHERE c.id STARTS WITH 'c-ai-de-' CREATE (t)-[:CONTAINS]->(c);

MATCH (c:Concept {id: "c-ai-de-001"}), (cc:ConceptClass {id: "cc-architecture"}) CREATE (c)-[:INSTANCE_OF]->(cc);
MATCH (c:Concept {id: "c-ai-de-002"}), (cc:ConceptClass {id: "cc-methodology"}) CREATE (c)-[:INSTANCE_OF]->(cc);
MATCH (c:Concept {id: "c-ai-de-003"}), (cc:ConceptClass {id: "cc-architecture"}) CREATE (c)-[:INSTANCE_OF]->(cc);
MATCH (c:Concept {id: "c-ai-de-004"}), (cc:ConceptClass {id: "cc-methodology"}) CREATE (c)-[:INSTANCE_OF]->(cc);
MATCH (c:Concept {id: "c-ai-de-005"}), (cc:ConceptClass {id: "cc-architecture"}) CREATE (c)-[:INSTANCE_OF]->(cc);
MATCH (c:Concept {id: "c-ai-de-006"}), (cc:ConceptClass {id: "cc-architecture"}) CREATE (c)-[:INSTANCE_OF]->(cc);

