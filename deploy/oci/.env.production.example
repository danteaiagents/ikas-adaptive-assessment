# IKAS Production Environment Variables
# Copy this file to .env.production and fill in your values.
# NEVER commit .env.production to git.

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_DEBUG=0

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_32_byte_hex_secret
JWT_SECRET_KEY=CHANGE_ME_generate_a_different_32_byte_hex_secret

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=ikas_user
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_PASSWORD=CHANGE_ME_strong_neo4j_password

# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
LLM_API_KEY=sk-ant-CHANGE_ME_your_claude_api_key

# ── CORS ──────────────────────────────────────────────────────────────────────
# Replace with your OCI VM public IP or domain
CORS_ORIGINS=http://YOUR_VM_IP,https://yourdomain.com

# ── OCI Object Storage (for image uploads — Sprint 3) ────────────────────────
OCI_NAMESPACE=CHANGE_ME_your_oci_tenancy_namespace
OCI_BUCKET_NAME=ikas-uploads
OCI_REGION=us-ashburn-1
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..CHANGE_ME
# On OCI VM use instance_principal (no API key needed).
# For local dev testing against OCI, use api_key.
OCI_AUTH_TYPE=instance_principal

# ── Docker image tag (optional — for registry-based deploys) ─────────────────
IMAGE_TAG=latest
